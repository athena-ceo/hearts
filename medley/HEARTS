(* revival: our ACTIVEREGIONS reimplementation -- medley/activeregions.lisp)
(RECORD ACTIVEREGION (REGION DATA HELPSTRING UPFN DOWNFN HIGHLIGHTFN))

(DEFINEQ

(ACTIVEREGIONS/DEFAULTHIGHLIGHTFN
  (LAMBDA (Win AR)
    (COND (AR (DSPFILL (fetch (ACTIVEREGION REGION) of AR) BLACKSHADE (QUOTE INVERT)
                       (WINDOWPROP Win (QUOTE DSP)))))))

(ACTIVEREGIONS/DOLOWLIGHT
  (LAMBDA (Win AR)
    (COND (AR (DSPFILL (fetch (ACTIVEREGION REGION) of AR) BLACKSHADE (QUOTE INVERT)
                       (WINDOWPROP Win (QUOTE DSP)))))))

(GETPICKREGION
  (LAMBDA (Win)
    (WINDOWPROP Win (QUOTE PickRegion))))

(SETACTIVEREGIONS
  (LAMBDA (Win ARList)
    (WINDOWPROP Win (QUOTE ActiveRegions) ARList)
    (WINDOWPROP Win (QUOTE BUTTONEVENTFN) (FUNCTION \AR.BUTTONEVENTFN))
    ARList))

(\AR.REGIONUNDER
  (LAMBDA (Win X Y)
    (for AR in (WINDOWPROP Win (QUOTE ActiveRegions))
       thereis (AND (INSIDEP (fetch (ACTIVEREGION REGION) of AR) X Y) AR))))

(\AR.BUTTONEVENTFN
  (LAMBDA (Win)
    (TOTOPW Win)
    (PROG ((AR (\AR.REGIONUNDER Win (LASTMOUSEX Win) (LASTMOUSEY Win))))
      (COND (AR
             (WINDOWPROP Win (QUOTE PickRegion) AR)
             (ACTIVEREGIONS/DEFAULTHIGHLIGHTFN Win AR)
             [while (NOT (MOUSESTATE UP)) do (BLOCK]
             (ACTIVEREGIONS/DOLOWLIGHT Win AR)
             (COND ((fetch (ACTIVEREGION UPFN) of AR)
                    (APPLY* (fetch (ACTIVEREGION UPFN) of AR)
                           Win
                           (fetch (ACTIVEREGION REGION) of AR)
                           (fetch (ACTIVEREGION DATA) of AR)))))))))

)
(* revival FIX -- CLOWN.Play dropped the FirstTrick? arg so the 2-of-clubs opening lead was never enforced; forward it. Original bug kept faithful in the transcription -- see HEARTS-BUGS.md)
(DEFINEQ
(CLOWN.Play (LAMBDA (Clown Trick HeartsBroken? FirstTrick?)
    (LET* ((Possibles (H.GetLegals (fetch Clown.Hand of Clown) Trick HeartsBroken? FirstTrick?))
           (Card (CAR (NTH Possibles (RAND 1 (LENGTH Possibles))))))
      (Hand.RemoveCard (fetch Clown.Hand of Clown) Card)
      Card)))
)
(* revival FIX -- CT.PrintStats redrew score/tricks without erasing so digits smeared; clear each field with WHITESHADE before drawing)
(DEFINEQ
(CT.PrintStats (LAMBDA (Win)
    (PROG ((DS (WINDOWPROP Win (QUOTE DSP)))
           (Tricks (WINDOWPROP Win (QUOTE Tricks)))
           (Score (WINDOWPROP Win (QUOTE Score))))
      (DSPFONT (QUOTE (GACHA 10 BOLD)) DS)
      (DSPFILL (CREATEREGION CT.X1 (DIFFERENCE CT.Y1 14) 96 12) WHITESHADE (QUOTE REPLACE) DS)
      (MOVETO CT.X1 (DIFFERENCE CT.Y1 12) DS)
      (printout DS "S: " (CAR Score) " T: " (CAR Tricks))
      (DSPFILL (CREATEREGION CT.X2 (DIFFERENCE CT.Y2 14) 96 12) WHITESHADE (QUOTE REPLACE) DS)
      (MOVETO CT.X2 (DIFFERENCE CT.Y2 12) DS)
      (printout DS "S: " (CADR Score) " T: " (CADR Tricks))
      (DSPFILL (CREATEREGION CT.X3 (PLUS CT.Y3 13) 96 12) WHITESHADE (QUOTE REPLACE) DS)
      (MOVETO CT.X3 (PLUS CT.Y3 15) DS)
      (printout DS "S: " (CADDR Score) " T: " (CADDR Tricks))
      (DSPFILL (CREATEREGION CT.X4 (DIFFERENCE CT.Y4 14) 96 12) WHITESHADE (QUOTE REPLACE) DS)
      (MOVETO CT.X4 (DIFFERENCE CT.Y4 12) DS)
      (printout DS "S: " (CADDDR Score) " T: " (CADDDR Tricks))
      (RETURN Win))))
)
(* revival patch: Card.PrintCard is called but never defined -- only the compact Card.Print exists. Supply a readable card name for the thought windows and help strings)
(DEFINEQ
(Card.PrintCard (LAMBDA (Card)
    (CONCAT (SELECTQ (fetch Value of Card) (J "Jack") (Q "Queen") (K "King") (A "Ace")
                     (fetch Value of Card))
            " of "
            (SELECTQ (fetch Suit of Card) (C "Clubs") (D "Diamonds") (H "Hearts") (S "Spades")
                     (fetch Suit of Card)))))
)
(* revival FIX -- HP.Play dropped the FirstTrick? arg so the 2-of-clubs opening lead was never enforced for the human; add it, forward to H.GetLegals, stash as a window prop. Original bug kept faithful in the transcription -- see HEARTS-BUGS.md H1)
(DEFINEQ
(HP.Play (LAMBDA (HWin Trick HeartsBroken? FirstTrick?)
    (LET ((Possibles (H.GetLegals (WINDOWPROP HWin (QUOTE Hand))
                                  Trick HeartsBroken? FirstTrick?))
          Card)
      (WINDOWPROP HWin (QUOTE CurrentTrick) Trick)
      (WINDOWPROP HWin (QUOTE HeartsBroken?) HeartsBroken?)
      (WINDOWPROP HWin (QUOTE FirstTrick?) FirstTrick?)
      (PROMPTPRINT (CONCAT "Your turn, " (WINDOWPROP HWin (QUOTE Name))))
      (HP.WaitForReady HWin "Please hurry. There are many impatient players here.")
      (SETQ Card (CAR (WINDOWPROP HWin (QUOTE SelectedCards))))
      (while (NOT (MEMBER Card Possibles))
         do (HP.Unselect HWin Card)
            (PROMPTPRINT "Illegal card. Try again.")
            (WINDOWPROP HWin (QUOTE Ready?) NIL)
            (HP.WaitForReady HWin "Please hurry. There are many impatient players here.")
            (SETQ Card (CAR (WINDOWPROP HWin (QUOTE SelectedCards)))))
      (if (WINDOWPROP HWin (QUOTE Legal))
          then (DOSELECTEDITEM (WINDOWPROP HWin (QUOTE HeartsMenu))
                               (CADDDR (fetch ITEMS of (WINDOWPROP HWin (QUOTE HeartsMenu))))))
      (HP.Unselect HWin Card)
      (HP.RemoveCard HWin Card)
      (WINDOWPROP HWin (QUOTE Ready?) NIL)
      Card)))
)
