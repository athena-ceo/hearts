(HP.Menuer
  [LAMBDA (Item Menu MouseKey)                                   (* rao "14-Apr-86 16:29")
    (LET ((HWin (CADR Item))
          (Type (CAR Item))
          Pass?)
      (SETQ Pass? (EQUAL (WINDOWPROP HWin (QUOTE PassOrPlay))
