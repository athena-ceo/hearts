(* "The examples in docs/medley-networking.md, as printed there.  The third example, Medley to
    Medley, runs in tests/run-hnet.sh.  Run with: tools/medley-headless tests/netguide.lisp")
(FILESLOAD UNIXCOMM)
(* "Example 1: a two-way pipe to a child process.")
(DEFINEQ
(Pipe.WriteLine
  (LAMBDA (S Line)
    (* ; "Flush every 256 bytes: past about 500 unflushed bytes, writes to a child are lost.  End with BOUT 10: TERPRI sends CR.")
    (for C in (CHCON Line) as I from 1
       do (BOUT S C)
          (if (EQ 0 (IREMAINDER I 256))
              then (FORCEOUTPUT S)))
    (BOUT S 10)
    (FORCEOUTPUT S)))
(Pipe.ReadLine
  (LAMBDA (S LimitMS)
    (* ; "One line, or NIL after LimitMS.  EOFP is true whenever nothing is waiting, so poll, and BLOCK so that other processes run.")
    (PROG ((Start (CLOCK 0)) Codes B)
      LOOP
          (if (IGREATERP (IDIFFERENCE (CLOCK 0) Start) LimitMS)
              then (RETURN NIL))
          (if (EOFP S)
              then (BLOCK 20)
                   (GO LOOP))
          (SETQ B (BIN S))
          (if (EQ B 10)
              then (RETURN (CONCATCODES (REVERSE Codes))))
          (push Codes B)
          (GO LOOP))))
)
(SETQ Upper (CREATE-PROCESS-STREAM "python3 -u -c 'import sys
for line in sys.stdin: sys.stdout.write(line.upper())'"))
(Pipe.WriteLine Upper "hello from Medley")
(HT.CHECK "ex1: a line each way" (Pipe.ReadLine Upper 5000) "HELLO FROM MEDLEY")
(Pipe.WriteLine Upper (ALLOCSTRING 5000 (CHARCODE a)))
(HT.CHECK "ex1: a long line arrives whole" (NCHARS (Pipe.ReadLine Upper 5000)) 5000)
(HT.CHECK "ex1: nothing more" (LIST (Pipe.ReadLine Upper 500)) (QUOTE (NIL)))
(CLOSEF Upper)
(* "The gotcha the flushing avoids: one unflushed 1000-byte write loses its end, newline included.")
(SETQ Raw (CREATE-PROCESS-STREAM "python3 -u -c 'import sys
for line in sys.stdin: print(len(line))'"))
(PROGN (PRIN3 (ALLOCSTRING 1000 (CHARCODE a)) Raw) (BOUT Raw 10) (FORCEOUTPUT Raw))
(HT.CHECK "gotcha: an unflushed long write is cut short" (LIST (Pipe.ReadLine Raw 3000)) (QUOTE (NIL)))
(CLOSEF Raw)
(* "Example 2: the Internet, through a command.  The child's end can't be seen (EOFP), so it prints a last line we can.")
(DEFINEQ
(Fetch
  (LAMBDA (Url)
    (* ; "The lines of the page at Url, using curl.  .END. marks the end; avoid _ in commands (MEDLEY-ISSUES M11).")
    (LET ((S (CREATE-PROCESS-STREAM (CONCAT "curl -s --max-time 20 '" Url "'; echo; echo .END."))))
         (CL:UNWIND-PROTECT
             (bind Line while (AND (SETQ Line (Pipe.ReadLine S 30000))
                                   (NOT (EQUAL Line ".END.")))
                collect Line)
             (CLOSEF S)))))
)
(SETQ Page (Fetch "https://example.com/"))
(HT.CHECK "ex2: fetched a page" (for L in Page thereis (STRPOS "Example Domain" L)))
(* "Gotcha: Medley's Common Lisp reader evaluates #. while reading, and has no *READ-EVAL* to stop it.")
(SETQ Evil NIL)
(CL:WITH-INPUT-FROM-STRING (In "#.(SETQ Evil 1)") (CL:READ In))
(HT.CHECK "gotcha: CL:READ evaluated #." Evil 1)
(SETQ Safe (COPYREADTABLE FILERDTBL))
(SETSYNTAX 35 (QUOTE OTHER) Safe)
(SETQ Evil NIL)
(CL:WITH-INPUT-FROM-STRING (In "#.(SETQ Evil 2)") (READ In Safe))
(HT.CHECK "gotcha: a readtable with # as OTHER evaluates nothing" (LIST Evil) (QUOTE (NIL)))
(HT.CHECK "gotcha: KWOTE leaves numbers, T and NIL bare"
  (LIST (KWOTE 3) (KWOTE T) (KWOTE NIL) (KWOTE "s") (KWOTE (QUOTE A))) (QUOTE (3 T NIL (QUOTE "s") (QUOTE A))))
