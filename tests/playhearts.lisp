(* "PLAYHEARTS: the menu-driven front door.  Session set-up, Start Game, a second game on a
    fresh table, Exit mid-game (process stopped, windows closed, Expert units deleted).
    Run with --loops.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/medley/EXPERT")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.AUTOPLACE)
(SETQ ThinkFlag? T)
(SETQ Game.OverScore 20)
(DEFINEQ (PHT.Wait (LAMBDA (Table Secs)
  (for I from 1 to (TIMES 2 Secs) while (PH.Running? Table) do (DISMISS 500))
  (NOT (PH.Running? Table))))
 (PHT.HeartsWindows (LAMBDA NIL
  (for W in (OPENWINDOWS) when (PH.HeartsWindow? W) collect (WINDOWPROP W (QUOTE TITLE))))))
(SETQ PHT.N0 (LENGTH (OPENWINDOWS)))
(SETQ T1 (PlayHearts (QUOTE (EP CP CLOWN EP))))
(HT.CHECK "table is open" (OPENWP T1))
(HT.CHECK "table has the menu bar" (ATTACHEDWINDOWS T1))
(HT.CHECK "nothing plays before Start Game" (NULL (PH.Running? T1)))
(SETQ NAME1 (UNIT.NAME (fetch Object of (CAR (WINDOWPROP T1 (QUOTE PH.Players))))))
(HT.CHECK "Start Game starts a game process" (PH.Start T1))
(HT.CHECK "Start Game again while playing is refused" (NULL (PH.Start T1)))
(HT.CHECK "game 1 finishes" (PHT.Wait T1 600))
(HT.CHECK "game 1 has a winner" (fetch Winners of H.LastGame))
(HT.SNAP "ph-game1")
(SETQ G1 H.LastGame)
(PH.Start PH.CurrentTable)
(DISMISS 4000)
(HT.CHECK "game 2 is on a fresh table" (AND (NEQ PH.CurrentTable T1) (NOT (OPENWP T1)) (OPENWP PH.CurrentTable)))
(HT.CHECK "game 2 is running" (PH.Running? PH.CurrentTable))
(SETQ PROC2 (PH.Running? PH.CurrentTable))
(HT.SNAP "ph-game2")
(PHT.HeartsWindows)
(PH.Exit PH.CurrentTable)
(DISMISS 1000)
(HT.CHECK "Exit stops the game process" (NOT (PROCESSP PROC2)))
(HT.CHECK "Exit closes every Hearts window" (NULL (PHT.HeartsWindows)))
(HT.CHECK "and the windows attached to them (menu bar, narration)" (LENGTH (OPENWINDOWS)) PHT.N0)
(HT.CHECK "Exit deletes the Expert units" (AND NAME1 (NULL (GetObjectRec NAME1))))
(HT.SNAP "ph-after-exit")
(* "Closing the table window instead of Exit ends the session too.")
(SETQ T3 (PlayHearts (QUOTE (CLOWN CP CLOWN CP))))
(CLOSEW T3)
(HT.CHECK "closing the table closes the rest" (NULL (PHT.HeartsWindows)))
(HT.CHECK "including its menu bar" (LENGTH (OPENWINDOWS)) PHT.N0)
(* "The interactive path: (PlayHearts) with no arguments asks with menus and a name prompt.
    Script the answers by advising MENU and PROMPTFORWORD.")
(SETQ PHT.Answers (QUOTE (HP EP CP CLOWN NO NO NO YES)))
(* "seats; open hands NO; Experts' thoughts NO; deal by hand NO; Conservatives' thoughts YES")
(ADVISE (QUOTE MENU) (QUOTE BEFORE) (QUOTE (RETURN (pop PHT.Answers))))
(ADVISE (QUOTE PROMPTFORWORD) (QUOTE BEFORE) (QUOTE (RETURN "Tester")))
(SETQ T4 (PlayHearts))
(UNADVISE (QUOTE MENU))
(UNADVISE (QUOTE PROMPTFORWORD))
(HT.CHECK "asked-for config" (WINDOWPROP T4 (QUOTE PH.Config)) (QUOTE (HP EP CP CLOWN)))
(HT.CHECK "human named from the prompt" (fetch Name of (CAR (WINDOWPROP T4 (QUOTE PH.Players)))) "Tester")
(HT.CHECK "Conservative thoughts on" ThinkFlag?)
(HT.CHECK "human window open" (MEMBER "Hearts Window for Tester" (PHT.HeartsWindows)))
(HT.SNAP "ph-asked")
(PH.Exit T4)
(HT.CHECK "and Exit cleans that up too" (NULL (PHT.HeartsWindows)))
(* "Expert thoughts windows (closed hands): the Experts narrate in their own Thoughts window,
    no cards are drawn there, and the 1986 functions are only advised, not redefined.")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.CHECK "exactly one piece of advice, even after reloading" (LENGTH (GETDEF (QUOTE Open.RemakeWindow) (QUOTE ADVICE) NIL (QUOTE NOERROR))) 1)
(HT.CHECK "and one on Open.Print" (LENGTH (GETDEF (QUOTE Open.Print) (QUOTE ADVICE) NIL (QUOTE NOERROR))) 1)
(HT.CHECK "no 1986 function redefined: both are only ADVISED" (AND (GETPROP (QUOTE Open.RemakeWindow) (QUOTE ADVISED)) (GETPROP (QUOTE Open.Print) (QUOTE ADVISED))))
(SETQ PH.ExpertThoughts? T)
(SETQ T5 (PlayHearts (QUOTE (EP CP EP CLOWN))))
(SETQ EWS (for W in (OPENWINDOWS) when (WINDOWPROP W (QUOTE PH.Thoughts)) collect W))
(HT.CHECK "one Thoughts window per Expert" (LENGTH EWS) 2)
(SETQ Y0 (DSPYPOSITION NIL (WINDOWPROP (CAR EWS) (QUOTE DSP))))
(PH.Start T5)
(HT.CHECK "game with Expert thoughts finishes" (PHT.Wait T5 600))
(HT.SNAP "ph-expert-thoughts")
(HT.CHECK "the Expert narrated there" (for W in EWS always (NEQ Y0 (DSPYPOSITION NIL (WINDOWPROP W (QUOTE DSP))))))
(HT.CHECK "no cards drawn in a Thoughts window" (for W in EWS always (NULL (WINDOWPROP W (QUOTE CardMap)))))
(HT.CHECK "no prompt window attached to it" (for W in EWS always (NULL (ATTACHEDWINDOWS W))))
(PH.Exit PH.CurrentTable)
(HT.CHECK "Exit closes the Expert thoughts windows" (NULL (PHT.HeartsWindows)))

(* "--- Layout (PH.AutoPlace?): the table in the middle, each player's hand window on their side
    of it (seat 1 above, 2 right, 3 below, 4 left), Thoughts windows in the corners, nothing
    overlapping, everything on the screen; Tidy puts a moved window back.")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.CHECK "one piece of advice on GETBOXREGION from PlayHearts, even after reloading"
          (for A in (GETDEF (QUOTE GETBOXREGION) (QUOTE ADVICE) NIL (QUOTE NOERROR)) count (MEMBER PH.PlaceAdvice A))
          1)
(DEFINEQ
(PHT.Mine (LAMBDA (Table)
  (CONS Table (for W in (OPENWINDOWS) when (AND (NEQ W Table) (PH.HeartsWindow? W)
                                                (NOT (MEMB W (WINDOWPROP Table (QUOTE PH.Before)))))
                 collect W))))
(PHT.Overlaps (LAMBDA (Ws)
  (for A on Ws join (for B in (CDR A) when (REGIONSINTERSECTP (WINDOWREGION (CAR A)) (WINDOWREGION B))
                       collect (LIST (WINDOWPROP (CAR A) (QUOTE TITLE)) (WINDOWPROP B (QUOTE TITLE)))))))
(PHT.OffScreen (LAMBDA (Ws)
  (for W in Ws collect (WINDOWPROP W (QUOTE TITLE))
     unless (LET ((R (WINDOWREGION W)))
                 (AND (GEQ (fetch (REGION LEFT) of R) 0) (GEQ (fetch (REGION BOTTOM) of R) 0)
                      (LEQ (PLUS (fetch (REGION LEFT) of R) (fetch (REGION WIDTH) of R)) SCREENWIDTH)
                      (LEQ (PLUS (fetch (REGION BOTTOM) of R) (fetch (REGION HEIGHT) of R)) SCREENHEIGHT))))))
(PHT.HandWindow (LAMBDA (Table Seat)
  (LET ((Name (MKSTRING (fetch Name of (CAR (NTH (WINDOWPROP Table (QUOTE PH.Players)) Seat))))))
       (for W in (CDR (PHT.Mine Table)) thereis (AND (NOT (PH.Thoughts? W)) (PH.TitleEndsWith? (WINDOWPROP W (QUOTE TITLE)) Name))))))
(PHT.Sides (LAMBDA (Table)
  (LET* ((T0 (WINDOWREGION Table))
         (L0 (fetch (REGION LEFT) of T0)) (B0 (fetch (REGION BOTTOM) of T0))
         (R0 (PLUS L0 (fetch (REGION WIDTH) of T0))) (U0 (PLUS B0 (fetch (REGION HEIGHT) of T0))))
        (for Seat from 1 to 4
           collect (LET* ((R (WINDOWPROP (PHT.HandWindow Table Seat) (QUOTE REGION)))
                          (L (fetch (REGION LEFT) of R)) (B (fetch (REGION BOTTOM) of R)))
                         (if (GEQ B U0) then (QUOTE ABOVE)
                           elseif (LEQ (PLUS B (fetch (REGION HEIGHT) of R)) B0) then (QUOTE BELOW)
                           elseif (GEQ L R0) then (QUOTE RIGHT)
                           elseif (LEQ (PLUS L (fetch (REGION WIDTH) of R)) L0) then (QUOTE LEFT)
                           else (QUOTE OVERLAPS)))))))
)
(SETQ ThinkFlag? T)
(SETQ T6 (PlayHearts (QUOTE (EP CP EP CP)) T))
(HT.CHECK "open hands: the table, four hand windows, four Thoughts windows" (LENGTH (PHT.Mine T6)) 9)
(HT.CHECK "no narration strip on the hand windows"
          (for Seat from 1 to 4 always (NULL (ATTACHEDWINDOWS (PHT.HandWindow T6 Seat)))))
(HT.CHECK "the table is in the middle of the screen"
          (LET ((R (WINDOWREGION T6)))
               (LESSP (ABS (DIFFERENCE (PLUS (fetch (REGION LEFT) of R) (IQUOTIENT (fetch (REGION WIDTH) of R) 2))
                                       (IQUOTIENT SCREENWIDTH 2)))
                      4)))
(HT.CHECK "each hand window is on its player's side" (PHT.Sides T6) (QUOTE (ABOVE RIGHT BELOW LEFT)))
(HT.CHECK "no two windows overlap" (LIST (PHT.Overlaps (PHT.Mine T6))) (QUOTE (NIL)))
(HT.CHECK "every window is on the screen" (LIST (PHT.OffScreen (PHT.Mine T6))) (QUOTE (NIL)))
(HT.CHECK "the table is on top" (EQ (WHICHW (PLUS (fetch (REGION LEFT) of (WINDOWPROP T6 (QUOTE REGION))) 200)
                                           (PLUS (fetch (REGION BOTTOM) of (WINDOWPROP T6 (QUOTE REGION))) 5))
                                    T6))
(HT.SNAP "ph-layout-open")
(SETQ HW2 (PHT.HandWindow T6 2))
(SETQ HW2R (WINDOWREGION HW2))
(MOVEW HW2 0 0)
(PH.Tidy T6)
(HT.CHECK "Tidy puts a moved window back" (WINDOWREGION HW2) HW2R)
(SETQ TWS (for W in (PHT.Mine T6) when (PH.Thoughts? W) collect W))
(SETQ TY0S (for W in TWS collect (DSPYPOSITION NIL (WINDOWPROP W (QUOTE DSP)))))
(PH.Start T6)
(HT.CHECK "open hands: a game runs" (PHT.Wait T6 600))
(HT.CHECK "every player narrated in their Thoughts window"
          (for W in TWS as Y in TY0S collect (NEQ Y (DSPYPOSITION NIL (WINDOWPROP W (QUOTE DSP)))))
          (QUOTE (T T T T)))
(HT.SNAP "ph-layout-open-played")
(PH.Exit PH.CurrentTable)
(HT.CHECK "open hands: Exit closes the hand windows' narration too" (LENGTH (OPENWINDOWS)) PHT.N0)
(SETQ PH.ExpertThoughts? T)
(SETQ T7 (PlayHearts (QUOTE (EP CP CLOWN EP))))
(HT.CHECK "closed hands: no two windows overlap" (LIST (PHT.Overlaps (PHT.Mine T7))) (QUOTE (NIL)))
(HT.CHECK "closed hands: every window is on the screen" (LIST (PHT.OffScreen (PHT.Mine T7))) (QUOTE (NIL)))
(HT.CHECK "closed hands: nothing under the prompt window"
          (for W in (CDR (PHT.Mine T7)) never (REGIONSINTERSECTP (WINDOWPROP W (QUOTE REGION)) (WINDOWPROP PROMPTWINDOW (QUOTE REGION)))))
(HT.SNAP "ph-layout-closed")
(SETQ EWS (for W in (PHT.Mine T7) when (WINDOWPROP W (QUOTE PH.Thoughts)) collect W))
(SETQ Y0S (for W in EWS collect (DSPYPOSITION NIL (WINDOWPROP W (QUOTE DSP)))))
(PH.Start T7)
(HT.CHECK "a game runs with the windows laid out" (PHT.Wait T7 600))
(HT.CHECK "the Experts narrate in their moved Thoughts windows"
          (for W in EWS as Y in Y0S always (NEQ Y (DSPYPOSITION NIL (WINDOWPROP W (QUOTE DSP))))))
(HT.SNAP "ph-layout-played")
(PH.Exit PH.CurrentTable)
(SETQ PH.AutoPlace? NIL)
(SETQ T8 (PlayHearts (QUOTE (CLOWN CLOWN CLOWN CLOWN))))
(HT.CHECK "with PH.AutoPlace? NIL the windows are placed by asking, as in 1986 (here, the harness answers)"
          (NOT (EQUAL (WINDOWREGION T8) (WINDOWREGION T6))))
(PH.Exit T8)
(SETQ PH.AutoPlace? T)
