(* "The network game, the house's side: two Conservatives here, two more from the guest's Medley
    through the relay, a full game to 100.  Run by tests/run-hnet.sh, with tests/hnet-guest.lisp.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/HNET")
(if (EQUAL (UNIX-GETENV (HNET.Sys "HNET_TRACE")) "1") then (SETQ HNET.Trace (OPENSTREAM "{DSK}/hearts/out/hnet-house-trace.txt" (QUOTE OUTPUT))))
(HT.AUTOPLACE)
(ADVISE (QUOTE CT.Open) (QUOTE AFTER) (QUOTE (WINDOWPROP !VALUE (QUOTE Delay) 0)))
(DEFINEQ
(HNT.WaitFor (LAMBDA (Form Secs)
  (for I from 1 to (TIMES 2 Secs) until (EVAL Form) do (DISMISS 500))
  (EVAL Form)))
)
(* "The parts, before connecting.")
(HT.CHECK "an HNET call is allowed"
  (HNET.Check (QUOTE (HNET.Apply (QUOTE 3) (QUOTE Play) (QUOTE ((H . 10)))))) (QUOTE (HNET.Apply 3 Play ((H . 10)))))
(HT.CHECK "so are constants, as KWOTE leaves them" (HNET.Check (QUOTE (HNET.DoIWantToPlay? 3 "x" T NIL))) (QUOTE (HNET.DoIWantToPlay? 3 "x" T NIL)))
(HT.CHECK "but not a symbol" (LIST (HNET.Check (QUOTE (HNET.DoIWantToPlay? HNT.Evil)))) (QUOTE (NIL)))
(HT.CHECK "any other function is refused" (LIST (HNET.Check (QUOTE (CLOSEALL)))) (QUOTE (NIL)))
(HT.CHECK "an unquoted argument is refused" (LIST (HNET.Check (QUOTE (HNET.Apply (CLOSEALL))))) (QUOTE (NIL)))
(HT.CHECK "GoodBye's SETQ is allowed" (HNET.Check (QUOTE (SETQ HNET.MyPlayers))) (QUOTE (SET HNET.MyPlayers NIL)))
(HT.CHECK "any other SETQ is refused" (LIST (HNET.Check (QUOTE (SETQ HNET.MyPlayers (CLOSEALL))))) (QUOTE (NIL)))
(HT.CHECK "data round-trips"
  (HNET.Decode (HNET.Encode (QUOTE ((H . 10) "two words" 3 -4 FOO NIL)))) (QUOTE ((H . 10) "two words" 3 -4 FOO NIL)))
(HT.CHECK "a list inside itself goes as NIL"
  (LET ((L (LIST 1 2))) (RPLACA (CDR L) L) (HNET.Decode (HNET.Encode L))) (QUOTE (1 NIL)))
(HT.CHECK "a dotted list round-trips" (HNET.Decode (HNET.Encode (QUOTE (1 2 . 3)))) (QUOTE (1 2 . 3)))
(HT.CHECK "a circular list stops"
  (LET ((L (LIST 1 2 3))) (RPLACD (CDDR L) L) (HNET.Decode (HNET.Encode L))) (QUOTE (1 2 3)))
(HT.CHECK "shared parts are kept"
  (LET ((C (CONS (QUOTE S) (QUOTE Q)))) (HNET.Decode (HNET.Encode (LIST C C)))) (QUOTE ((S . Q) (S . Q))))
(HT.CHECK "what can't be printed goes as NIL" (HNET.Decode (HNET.Encode (LIST 1 (ARRAY 2)))) (QUOTE (1 NIL)))
(SETQ HNT.Evil NIL)
(HT.CHECK "HNET's evaluates nothing" (PROGN (HNET.Decode "#.(SETQ HNT.Evil 2)") (HNET.Decode "#,(SETQ HNT.Evil 3)") (LIST HNT.Evil)) (QUOTE (NIL)))
(HT.CHECK "a long list is one line"
  (LET ((S (HNET.Encode (for I from 1 to 2000 collect I))))
       (AND (IGREATERP (NCHARS S) 8000) (NOT (STRPOS (CHARACTER 10) S)) (NOT (STRPOS (CHARACTER 13) S)))))
(HT.CHECK "words" (HNET.Words "CALL guest 12 (A B)" 3) (QUOTE ("CALL" "guest" "12")))
(HT.CHECK "the rest" (HNET.Rest "CALL guest 12 (A B)" 3) "(A B)")
(HT.CHECK "no peers" (LIST (HNET.Rest "PEERS " 1)) (QUOTE (NIL)))
(HT.CHECK "found the link" (HNET.FindLink) "/hearts/dist/hnetlink.py")
(HT.CHECK "a bad name is refused" (CAR (HNET.Connect "room" "two words")) (QUOTE ERROR))
(HT.CHECK "no relay is an error" (CAR (HNET.Connect "room" "house" "ws://127.0.0.1:1")) (QUOTE ERROR))
(HT.CHECK "REMOTEVAL unconnected is an error" (LIST (NLSETQ (REMOTEVAL (QUOTE (HNET.CT.Open (QUOTE NIL))) "guest"))) (QUOTE (NIL)))
(* "The game.")
(HT.CHECK "the house connects" (HNET.Connect "hnettest" "house") "house")
(HT.CHECK "the guest is there" (HNT.WaitFor (QUOTE (MEMBER "guest" (HNET.PeerNames))) 120))
(HT.CHECK "the guest has players waiting" (HNT.WaitFor (QUOTE (MEMBER "ready" (HNET.PeerNames))) 120))
(SETQ H.LastGame NIL)
(SETQ HNT.Start (CLOCK 0))
(HT.CHECK "a game to 100 finishes" (Hearts (LIST (CP.Create NIL) (CP.Create NIL)) NIL NIL))
(HT.CHECK "seats 3 and 4 came from the net"
  (for P in (fetch Players of H.LastGame) collect (fetch Type of P)) (QUOTE (Lisp Lisp Net Net)))
(HT.CHECK "and they are the guest's"
  (for P in (CDDR (fetch Players of H.LastGame)) collect (fetch HNP.Host of (fetch Object of P))) (QUOTE ("guest" "guest")))
(HT.CHECK "the house kept the guest's hands in step, to the last card (H7)"
  (AND (EQ 2 (LENGTH HNET.Hands)) (for X in HNET.Hands always (NULL (Hand.Cards (CDR X))))))
(HT.CHECK "someone won" (fetch Winners of H.LastGame))
(HT.CHECK "someone reached 100" (for S in (fetch Score of H.LastGame) thereis (IGREATERP S 99)))
(LIST (QUOTE SECONDS) (IQUOTIENT (IDIFFERENCE (CLOCK 0) HNT.Start) 1000) (QUOTE CALLS) HNET.Sent)
(LIST (QUOTE SCORE) (fetch Score of H.LastGame))
(HT.CHECK "nothing was refused" (LIST HNET.Refused) (QUOTE (NIL)))
(HNET.GoodBye)
(DISMISS 3000)
(* "The guide's third example, from this side.")
(HT.CHECK "ex3: call a function on another Medley" (REMOTEVAL (LIST (QUOTE Greet) (KWOTE "house")) "guest") "Hello house, this is guest")
(HT.CHECK "ex3: or on whichever answers" (REMOTEVAL (LIST (QUOTE Greet) (KWOTE "anyone")) NIL T 3000) "Hello anyone, this is guest")
(HT.CHECK "ex3: a function it didn't allow is an error" (LIST (NLSETQ (REMOTEVAL (QUOTE (HNET.Name)) "guest"))) (QUOTE (NIL)))
(HT.SNAP "hnet-house")
(HNET.Disconnect)
(HT.CHECK "disconnected" (LIST (HNET.Connected?)) (QUOTE (NIL)))
