(* "A visitor to the resident Medley (docker/resident.lisp) from another Medley: PlayHearts with one
    seat of its own and the rest online, as (PlayHearts '(CP NET)).  The house opens a table, puts the
    resident's players in the other seats, and runs the game over Courier.  Run by tests/run-resident.sh.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/HCOURIER")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.AUTOPLACE)
(ADVISE (QUOTE CT.Open) (QUOTE AFTER) (QUOTE (WINDOWPROP !VALUE (QUOTE Delay) 0)))
(DEFINEQ
(RV.WaitFor (LAMBDA (Form Secs)
  (for I from 1 to (TIMES 2 Secs) until (EVAL Form) do (DISMISS 500))
  (EVAL Form)))
(RV.Offered (LAMBDA NIL
  (* ; "The players a Medley offers to everyone, as the house lists them now.")
  (for O in (HC.Opponents) when (AND (LISTP O) (STRPOS "medley:" (CAR O) 1 NIL T)) collect (CADR O))))
(RV.Names (LAMBDA NIL
  (for P in (WINDOWPROP PH.CurrentTable (QUOTE PH.Players)) collect (MKSTRING (fetch Name of P)))))
)
(DISMISS 5000)
(HT.CHECK "the house answers" (LISTP (HC.Opponents)))
(HT.CHECK "the resident is offering three players" (RV.WaitFor (QUOTE (EQ 3 (LENGTH (RV.Offered)))) 600))
(HT.LOG (LIST (QUOTE OFFERED) (RV.Offered)))
(HT.CHECK "PlayHearts opens an online table" (WINDOWP (PlayHearts (QUOTE (CP NET)) NIL NIL)))
(HT.CHECK "seats 2 to 4 are online" (WINDOWPROP PH.CurrentTable (QUOTE PH.Config)) (QUOTE (CP NET NET NET)))
(SETQ RV.Start (CLOCK 0))
(PH.Start PH.CurrentTable)
(HT.CHECK "the game starts at a table of the house" (RV.WaitFor (QUOTE HC.Playing) 60))
(HT.CHECK "the resident's players sit in seats 2 to 4" (CDR (RV.Names)) (QUOTE ("Expert on Medley" "Neural network on Medley" "Conservative on Medley")))
(HT.CHECK "PlayHearts' table, with its menu bar, shows the game" (AND (EQ PH.CurrentTable HNET.CardTable) (ATTACHEDWINDOWS PH.CurrentTable) T))
(HT.CHECK "nobody else can take the resident's players meanwhile" (LIST (RV.Offered)) (QUOTE (NIL)))
(RV.WaitFor (QUOTE (AND HC.Scores (for S in HC.Scores thereis (IGREATERP S 20)))) 1800)
(HT.SNAP "visitor-game")
(HT.CHECK "the game ends" (RV.WaitFor (QUOTE HC.Winners) 3000))
(LIST (QUOTE SECONDS) (IQUOTIENT (IDIFFERENCE (CLOCK 0) RV.Start) 1000) (QUOTE SCORE) HC.Scores (QUOTE WINNERS) HC.Winners)
(HT.CHECK "someone went over 100" (for S in HC.Scores thereis (IGREATERP S 100)))
(HT.CHECK "the game's process ended" (RV.WaitFor (QUOTE (NOT (PH.Running? PH.CurrentTable))) 20))
(HT.CHECK "afterwards the resident offers fresh players" (RV.WaitFor (QUOTE (EQ 3 (LENGTH (RV.Offered)))) 240))
(HT.CHECK "Exit closes the session" (PROGN (PH.Exit PH.CurrentTable) (LIST HC.Players PH.CurrentTable)) (QUOTE (NIL NIL)))
(* "' and backquote in the Interlisp readtable, as typed at the Exec.")
(SETQ RV.Me (QUOTE (Harley 1)))
(HT.CHECK "' and backquote read as at the Exec"
  (CL:WITH-INPUT-FROM-STRING (In "(LIST 'A `(Hearts ',(LIST RV.Me)))") (EVAL (READ In (FIND-READTABLE "INTERLISP"))))
  (QUOTE (A (Hearts (QUOTE ((Harley 1)))))))
