(* "LLM player, with no key and no spending.  Full games on the stub helper and through the real
    SDK against a local mock server; every way the helper can fail; the PlayHearts front door.
    Run with: tools/medley-headless --timeout 900 tests/llmplayer.lisp")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/LLMPLAYER")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.AUTOPLACE)
(SETQ LT.Log "/hearts/out/llmplayer-test.jsonl")
(NLSETQ (DELFILE (CONCAT "{UNIX}" LT.Log)))
(DEFINEQ
(LT.CheckPlay (LAMBDA (Card)
  (SETQ LT.Plays (ADD1 LT.Plays))
  (if (NOT (MEMBER Card LT.Legal)) then (push LT.Illegal Card))
  Card))
(LT.Game (LAMBDA (Options Config)
  (SETQ LP.HelperOptions Options)
  (LP.ResetStats)
  (SETQ H.LastGame NIL)
  (Hearts (for X in Config collect (H.MakePlayer X NIL)) NIL NIL)
  (fetch Winners of H.LastGame)))
(LT.Decide (LAMBDA (Options)
  (* ; "One real decision with the helper in the given mode.  Returns the card and the fallback count.")
  (SETQ LP.HelperOptions Options)
  (LP.ResetStats)
  (LET* ((Player (H.MakePlayer (QUOTE LP) NIL))
         (Self (fetch Object of Player))
         (Cards (for V in (QUOTE (2 3 9 K)) collect (Card.Create V (QUOTE D))))
         (Trick (create Trick Cards _ (LIST (Card.Create 5 (QUOTE D))) LeadPlayerNum _ 4)))
    (LP.GiveHand Self (Hand.Create (APPEND Cards (LIST (Card.Create (QUOTE Q) (QUOTE S)))) Player) 1)
    (LIST (LP.CardName (LP.Play Self Trick NIL NIL)) LP.Fallbacks))))
(LT.Wait (LAMBDA (Table Secs)
  (for I from 1 to (TIMES 2 Secs) while (PH.Running? Table) do (DISMISS 500))
  (NOT (PH.Running? Table))))
(LT.Run (LAMBDA (Command)
  (LP.ParseReply (LP.ReadProcessLine Command))))
)
(ADVISE (QUOTE LP.Play) (QUOTE BEFORE) (QUOTE (SETQ LT.Legal (H.GetLegals (fetch LP.Hand of self) Trick HeartsBroken? FirstTrick?))))
(ADVISE (QUOTE LP.Play) (QUOTE AFTER) (QUOTE (LT.CheckPlay !VALUE)))
(SETQ LT.Plays 0)
(SETQ LT.Illegal NIL)

(* "--- the helper is found and reports what it has")
(HT.CHECK "helper found" (LP.FindHelper) "/hearts/dist/llm_player.py")
(SETQ LT.Check (LP.Check))
(HT.CHECK "LP.Check reports" (CAR LT.Check) (QUOTE CHECK))
(HT.CHECK "LP.Check names the model" (CAR (LAST LT.Check)) "claude-opus-5-5")

(* "--- a full game to 100 on the stub, with a decision log")
(SETQ LP.LogFile LT.Log)
(HT.CHECK "stub game: LP vs CP, CLOWN, CP finishes" (AND (LT.Game "--stub lowest" (QUOTE (LP CP CLOWN CP))) T))
(HT.CHECK "stub game: played to over 100" (for S in (fetch Score of H.LastGame) thereis (IGREATERP S 100)))
(LP.Stats)
(HT.CHECK "stub game: asked the helper" (IGREATERP LP.Decisions 20))
(HT.CHECK "stub game: never fell back" LP.Fallbacks 0)
(SETQ LP.LogFile NIL)
(HT.CHECK "requests hold only what the seat may know" (LT.Run (CONCAT "python3 /hearts/tests/check_llm_log.py " LT.Log)) T)
(HT.SNAP "llm-stub-game")

(* "--- a short game with four LLM seats")
(* "A deal takes about 30 seconds, mostly the card table, so the rest are kept short.")
(SETQ Game.OverScore 10)
(HT.CHECK "four LP seats finish" (AND (LT.Game "--stub lowest" (QUOTE (LP LP LP LP))) T))
(HT.CHECK "four LP seats never fell back" LP.Fallbacks 0)

(* "--- the helper answering badly for a whole game: it must stay legal and finish")
(HT.CHECK "illegal answers: game finishes" (AND (LT.Game "--stub illegal" (QUOTE (LP CP CP CP))) T))
(HT.CHECK "illegal answers: all rejected" (AND (IGREATERP LP.Fallbacks 5) (EQP LP.Fallbacks LP.Decisions)))
(HT.CHECK "error replies: game finishes" (AND (LT.Game "--stub error" (QUOTE (LP CP CP CP))) T))
(HT.CHECK "error replies: all fell back" (EQP LP.Fallbacks LP.Decisions))

(* "--- single decisions in the other failure modes; the hand allows D2 D3 D9 DK on a diamond lead")
(HT.CHECK "stub plays the first legal card" (LT.Decide "--stub lowest") (QUOTE ("D2" 0)))
(HT.CHECK "garbage reply falls back to lowest" (LT.Decide "--stub garbage") (QUOTE ("D2" 1)))
(HT.CHECK "helper dying falls back" (LT.Decide "--stub die") (QUOTE ("D2" 1)))
(SETQ LP.Python "/nonexistent/python3")
(SETQ LT.T0 (CLOCK 0))
(HT.CHECK "python missing falls back" (LT.Decide "--stub lowest") (QUOTE ("D2" 1)))
(HT.CHECK "python missing costs no wait" (ILESSP (IDIFFERENCE (CLOCK 0) LT.T0) 3000))
(SETQ LP.Python "python3")
(SETQ LP.Helper "/nonexistent/llm_player.py")
(HT.CHECK "helper file missing falls back" (LT.Decide "--stub lowest") (QUOTE ("D2" 1)))
(SETQ LP.Helper NIL)
(SETQ LP.TimeoutSeconds 3)
(SETQ LP.GraceSeconds 1)
(SETQ LT.T0 (CLOCK 0))
(HT.CHECK "stuck helper falls back" (LT.Decide "--stub hang") (QUOTE ("D2" 1)))
(SETQ LT.Waited (IDIFFERENCE (CLOCK 0) LT.T0))
(HT.CHECK "stuck helper waits only the limit" (AND (IGREATERP LT.Waited 3500) (ILESSP LT.Waited 8000)))
(SETQ LP.TimeoutSeconds 300)
(SETQ LP.GraceSeconds 15)

(* "--- other Lisp processes keep running while the model thinks")
(SETQ LT.Ticks 0)
(SETQ LT.Ticker (ADD.PROCESS (QUOTE (while T do (SETQ LT.Ticks (ADD1 LT.Ticks)) (BLOCK 100))) (QUOTE NAME) (QUOTE LTTICK)))
(DISMISS 300)
(SETQ LT.Before LT.Ticks)
(HT.CHECK "slow helper still answers" (LT.Decide "--stub slow") (QUOTE ("D2" 0)))
(HT.CHECK "other processes ran during the wait" (IGREATERP (IDIFFERENCE LT.Ticks LT.Before) 15))
(DEL.PROCESS LT.Ticker)

(* "--- the real SDK and helper path, against the local mock server, for a whole game")
(SETQ LT.Mock (CREATE-PROCESS-STREAM "python3 /hearts/tests/mock_anthropic.py 8765"))
(DISMISS 2000)
(SETQ LP.Python "ANTHROPIC_BASE_URL=http://127.0.0.1:8765 ANTHROPIC_API_KEY=test-key python3")
(HT.CHECK "through the SDK: game finishes" (AND (LT.Game "" (QUOTE (LP LP CP CLOWN))) T))
(LP.Stats)
(HT.CHECK "through the SDK: never fell back" LP.Fallbacks 0)
(HT.CHECK "through the SDK: tokens are counted" (EQP LP.InputTokens (ITIMES 100 LP.Decisions)))
(HT.CHECK "through the SDK: output tokens too" (EQP LP.OutputTokens (ITIMES 20 LP.Decisions)))
(HT.SNAP "llm-mock-game")
(CLOSEF LT.Mock)
(SETQ LP.Python "python3")

(* "--- the awkward characters the helper escapes come back as written")
(SETQ LT.Reply (LP.ParseReply "(OK ((S . 10)) %"say %%%"go%%%" 100%%%% now%" %"r%" (1 2 3))"))
(HT.CHECK "ten of spades reads as a card" (CAADR LT.Reply) (QUOTE (S . 10)))
(HT.CHECK "quotes and percents survive" (CADDR LT.Reply) "say %"go%" 100%% now")

(* "--- long thoughts wrap instead of running off the window")
(HT.CHECK "wrap breaks at spaces" (LP.Wrap "aaa bbb ccc" 4) (QUOTE ("aaa " "bbb " "ccc")))
(HT.CHECK "wrap splits a long word" (LP.Wrap "abcdefgh" 3) (QUOTE ("abc" "def" "gh")))
(HT.CHECK "wrap leaves short text alone" (LP.Wrap "abc" 10) (QUOTE ("abc")))
(HT.CHECK "wrap takes atoms" (LP.Wrap (QUOTE abc) 10) (QUOTE ("abc")))

(* "--- a player kept for a new game forgets the old one's scores")
(SETQ LT.Self (fetch Object of (H.MakePlayer (QUOTE LP) NIL)))
(replace LP.Scores of LT.Self with (LIST (ADD1 Game.OverScore) 0 0 0))
(replace LP.Deal of LT.Self with 7)
(LP.GiveHand LT.Self (Hand.Create NIL NIL) 1)
(HT.CHECK "new game: scores cleared" (NULL (fetch LP.Scores of LT.Self)))
(HT.CHECK "new game: deals recounted" (fetch LP.Deal of LT.Self) 1)

(* "--- every LP play in every game above was legal")
(HT.CHECK "every LP play was legal" (NULL LT.Illegal))
(HT.CHECK "many plays were checked" (IGREATERP LT.Plays 100))
LT.Plays

(* "--- PlayHearts: the menu knows it, a game runs, Exit cleans up")
(HT.CHECK "PlayHearts menu lists it" (for E in PH.PlayerTypes thereis (EQUAL (CADR E) (QUOTE (QUOTE LP)))))
(SETQ LP.HelperOptions "--stub slow")
(SETQ LT.Before (OPENWINDOWS))
(SETQ T1 (PlayHearts (QUOTE (LP CP CLOWN CP))))
(HT.CHECK "PH: table open" (OPENWP T1))
(HT.CHECK "PH: has a Thoughts window" (for W in (OPENWINDOWS) thereis (STRPOS "Thoughts of Claude" (WINDOWPROP W (QUOTE TITLE)))))
(HT.CHECK "PH: starts" (PH.Start T1))
(DISMISS 15000)
(HT.SNAP "llm-playhearts")
(SETQ LT.Proc (PH.Running? T1))
(PH.Exit T1)
(DISMISS 1000)
(HT.CHECK "PH: Exit stops the game" (NOT (PROCESSP LT.Proc)))
(HT.CHECK "PH: Exit closes its windows" (NULL (for W in (OPENWINDOWS) when (AND (PH.HeartsWindow? W) (NOT (MEMB W LT.Before))) collect W)))
