(* "The neural network player, in pure Interlisp: reads its weights, plays whole games legally and
    at speed, thinks aloud, and works from PlayHearts.  That it plays the same moves as Python was
    checked by playing the same deals both ways: see HANDOFF.md.  Run with:
    tools/medley-headless --timeout 900 tests/nnplayer.lisp")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/NNPLAYER")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.AUTOPLACE)
(HT.CHECK "found the network file" (NP.FindModel) "/hearts/dist/HEARTSNET")
(HT.CHECK "the arithmetic is compiled" (CCODEP (QUOTE NP.Layer)))
(NP.Load)
(HT.CHECK "read every layer" (AND (ARRAYP (CAR NP.Net)) (ARRAYP (CADDR NP.Net)) (ARRAYP (CAR (CDDDDR NP.Net)))))

(* "--- whole games, each play checked against the rules")
(SETQ LT.Plays 0)
(SETQ LT.Illegal NIL)
(DEFINEQ
(LT.CheckPlay (LAMBDA (Card)
  (SETQ LT.Plays (ADD1 LT.Plays))
  (if (NOT (MEMBER Card LT.Legal)) then (push LT.Illegal Card))
  Card))
)
(ADVISE (QUOTE NP.Play) (QUOTE BEFORE) (QUOTE (SETQ LT.Legal (H.GetLegals (fetch NP.Hand of self) Trick HeartsBroken? FirstTrick?))))
(ADVISE (QUOTE NP.Play) (QUOTE AFTER) (QUOTE (LT.CheckPlay !VALUE)))
(SETQ H.LastGame NIL)
(Hearts (for X in (QUOTE (NP CP CLOWN CP)) collect (H.MakePlayer X NIL)) NIL NIL)
(HT.CHECK "a game to 100 finishes" (fetch Winners of H.LastGame))
(HT.SNAP "np-game")
(SETQ Game.OverScore 10)
(Hearts (for X in (QUOTE (NP NP NP NP)) collect (H.MakePlayer X NIL)) NIL NIL)
(HT.CHECK "four networks finish" (fetch Winners of H.LastGame))
(HT.CHECK "every play was legal" (NULL LT.Illegal))
(HT.CHECK "many plays were checked" (IGREATERP LT.Plays 100))
LT.Plays
(NP.Stats)
(HT.CHECK "a move takes under a second" (ILESSP (IQUOTIENT NP.Milliseconds NP.Moves) 1000))

(* "--- thinking aloud")
(SETQ LT.Cards (LIST (Card.Create 2 (QUOTE D)) (Card.Create (QUOTE K) (QUOTE D))))
(HT.CHECK "shares add up" (STRPOS "D2" (NP.Summary (QUOTE play) LT.Cards (LIST 1.0 0.0))))

(* "--- no file: says so rather than playing badly")
(SETQ LT.File NP.ModelFile)
(SETQ NP.ModelFile "/nonexistent/net")
(HT.CHECK "a missing file is an error" (NULL (NLSETQ (NP.Load T))))
(SETQ NP.ModelFile LT.File)
(NP.Load T)

(* "--- PlayHearts")
(HT.CHECK "PlayHearts menu lists it" (for E in PH.PlayerTypes thereis (EQUAL (CADR E) (QUOTE (QUOTE NP)))))
(SETQ LT.Before (OPENWINDOWS))
(SETQ T1 (PlayHearts (QUOTE (NP CP CLOWN CP))))
(HT.CHECK "PH: has a Thoughts window" (for W in (OPENWINDOWS) thereis (STRPOS "Thoughts of Neural" (WINDOWPROP W (QUOTE TITLE)))))
(HT.CHECK "PH: starts" (PH.Start T1))
(DISMISS 12000)
(HT.SNAP "np-playhearts")
(SETQ LT.Proc (PH.Running? T1))
(PH.Exit T1)
(DISMISS 1000)
(HT.CHECK "PH: Exit stops the game" (NOT (PROCESSP LT.Proc)))
