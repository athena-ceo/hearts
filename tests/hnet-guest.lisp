(* "The network game, the guest's side: offers two Conservatives, plays them when the house's
    Medley asks, shows the game on its own card table.  Run by tests/run-hnet.sh.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/HNET")
(if (EQUAL (UNIX-GETENV (HNET.Sys "HNET_TRACE")) "1") then (SETQ HNET.Trace (OPENSTREAM "{DSK}/hearts/out/hnet-guest-trace.txt" (QUOTE OUTPUT))))
(HT.AUTOPLACE)
(ADVISE (QUOTE CT.Open) (QUOTE AFTER) (QUOTE (WINDOWPROP !VALUE (QUOTE Delay) 0)))
(DEFINEQ
(HNT.WaitFor (LAMBDA (Form Secs)
  (for I from 1 to (TIMES 2 Secs) until (EVAL Form) do (DISMISS 500))
  (EVAL Form)))
)
(SETQ HNT.Tricks 0)
(SETQ HNT.Results 0)
(SETQ HNT.Plays 0)
(CL:PROCLAIM (QUOTE (CL:SPECIAL HNT.Tricks HNT.Results HNT.Plays)))
(ADVISE (QUOTE CP.Trick) (QUOTE BEFORE) (QUOTE (SETQ HNT.Tricks (ADD1 HNT.Tricks))))
(ADVISE (QUOTE CP.Results) (QUOTE BEFORE) (QUOTE (SETQ HNT.Results (ADD1 HNT.Results))))
(ADVISE (QUOTE CP.Play) (QUOTE BEFORE) (QUOTE (SETQ HNT.Plays (ADD1 HNT.Plays))))
(* "The guide's third example: a function of our own that another Medley may call.")
(DEFINEQ
(Greet
  (LAMBDA (Who)
    (CONCAT "Hello " Who ", this is " HNET.Name)))
)
(SETQ HNET.Allowed (CONS (QUOTE Greet) HNET.Allowed))
(HT.CHECK "the guest connects" (HNET.Connect "hnettest" "guest") "guest")
(HT.CHECK "it offers two players" (PROGN (NetHearts (LIST (CP.Create NIL) (CP.Create NIL))) (LENGTH H.WaitingToPlay)) 2)
(* "Tell the house we are ready: a second connection would do, but a marker peer is simpler.  hnet-ready joins as 'ready'.")
(SETQ HNT.Ready (CREATE-PROCESS-STREAM (HNET.Sys "python3 -u /hearts/dist/hnetlink.py $HNET_RELAY hnettest ready")))
(HT.CHECK "the house takes both" (HNT.WaitFor (QUOTE (EQ 2 (LENGTH HNET.MyPlayers))) 300))
(HT.CHECK "seats 3 and 4" (for P in HNET.MyPlayers collect (fetch Number of P)) (QUOTE (3 4)))
(HT.CHECK "a card table opened here" (WINDOWP HNET.CardTable))
(HT.CHECK "the house says goodbye" (HNT.WaitFor (QUOTE (NULL HNET.MyPlayers)) 1500))
(LIST (QUOTE SCORE) (WINDOWPROP HNET.CardTable (QUOTE Score)))
(LIST (QUOTE SERVED) HNET.Served (QUOTE PLAYS) HNT.Plays (QUOTE TRICKS) HNT.Tricks (QUOTE RESULTS) HNT.Results)
(HT.CHECK "our players played" (IGREATERP HNT.Plays 100))
(HT.CHECK "they heard every trick (H6)" HNT.Tricks HNT.Plays)
(HT.CHECK "and every deal's result (H6)" (TIMES 13 HNT.Results) HNT.Plays)
(HT.CHECK "nothing the house sent was refused, but for its test of a refusal"
  (for R in HNET.Refused always (EQUAL R (QUOTE ("house" (HNET.Name))))))
(HT.SNAP "hnet-guest")
(* "Now an intruder (tests/hnet-intruder.py) sends forms that aren't game calls.")
(HT.CHECK "the intruder's forms are refused"
  (HNT.WaitFor (QUOTE (EQ 2 (for R in HNET.Refused count (EQUAL (CAR R) "intruder")))) 300))
(HT.CHECK "and none ran" (WINDOWP HNET.CardTable))
(HNET.Disconnect)
