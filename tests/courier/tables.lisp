(* "One Medley at several tables at once: it offers three players to everyone, and web visitors (tests/tables_visitors.py) each open a table with them.  Checks that one game is on show and the others are quiet, that choosing another game puts it on the screen up to date, and that every game ends.  Run by tests/run-courier.sh with VISITORS=4 LOOPS=1.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/HCOURIER")
(LOAD "{DSK}/hearts/dist/NNPLAYER")
(LOAD "{DSK}/hearts/medley/EXPERT")
(LOAD "{DSK}/hearts/dist/PLAYHEARTS")
(HT.AUTOPLACE)
(SETQ ThinkFlag? T)
(DEFINEQ
(HCT.WaitFor (LAMBDA (Form Secs)
  (for I from 1 to (TIMES 2 Secs) until (EVAL Form) do (DISMISS 500))
  (EVAL Form)))
(HCT.Make (LAMBDA (Type)
  (* ; "As the resident makes its players: an Expert gets a Thoughts window, the others make their own.")
  (LET ((Player (H.MakePlayer Type NIL)))
       (if (EQ Type (QUOTE EP)) then (PH.GiveThoughtsWindow Player))
       Player)))
(HCT.Thoughts (LAMBDA NIL
  (* ; "The Thoughts windows open on the screen.")
  (for W in (OPENWINDOWS) when (AND (STRINGP (WINDOWPROP W (QUOTE TITLE))) (STRPOS "Thoughts of " (WINDOWPROP W (QUOTE TITLE)) 1 NIL T)) collect W)))
(HCT.CardTables (LAMBDA NIL
  (for W in (OPENWINDOWS) when (AND (STRINGP (WINDOWPROP W (QUOTE TITLE))) (STRPOS "Hearts Card Table" (WINDOWPROP W (QUOTE TITLE)) 1 NIL T)) collect W)))
(HCT.OnShow? (LAMBDA (Game)
  (* ; "GAME alone is on the screen: its card table, and its players' Thoughts windows and no others.")
  (AND (EQ HC.Shown Game)
       (EQUAL (HCT.CardTables) (LIST (fetch (HCGAME Window) of Game)))
       (EQ 3 (LENGTH (HCT.Thoughts)))
       (for W in (HCT.Thoughts) always (MEMB W (fetch (HCGAME Windows) of Game))))))
(HCT.UpToDate? (LAMBDA (Game)
  (* ; "The card table shows GAME's score.")
  (EQUAL (WINDOWPROP (fetch (HCGAME Window) of Game) (QUOTE Score)) (fetch (HCGAME Totals) of Game))))
(HCT.Other (LAMBDA NIL
  (for Game in HC.Games unless (EQ Game HC.Shown) do (RETURN Game))))
(HCT.Totals (LAMBDA (Game) (fetch (HCGAME Totals) of Game)))
(HCT.Winners (LAMBDA (Game) (fetch (HCGAME Winners) of Game)))
)
(SETQ HCT.Want (OR (FIXP (MKATOM (UNIX-GETENV "VISITORS"))) 4))
(SETQ HCT.Finished NIL)
(ADVISE (QUOTE HC.End) (QUOTE AFTER) (QUOTE (push HCT.Finished Game)))
(DISMISS 5000)
(HT.CHECK "three players are offered to everyone, for eight tables"
  (HC.Offer (QUOTE ((HCT.Make (QUOTE EP)) (HCT.Make (QUOTE NP)) (HCT.Make (QUOTE CP)))) "test-key" (QUOTE ("Expert on Medley" "Neural network on Medley" "Conservative on Medley")) 8) T)
(HT.CHECK "every visitor's game is being played here at once" (HCT.WaitFor (QUOTE (EQ (LENGTH HC.Games) HCT.Want)) 300))
(HT.LOG (LIST (QUOTE GAMES) (LENGTH HC.Games)))
(SETQ HCT.First HC.Shown)
(HT.CHECK "one game is on show: its card table and its three players' Thoughts windows, and no other's" (HCT.OnShow? HCT.First))
(DISMISS 4000)
(HT.CHECK "it is still the only one on the screen while the others play" (HCT.OnShow? HCT.First))
(HT.SNAP "tables-first")
(* "Choosing another game: only with two games or more.")
(if (IGREATERP HCT.Want 1)
    then (SETQ HCT.Second (HCT.Other))
         (HC.Pick HCT.Second)
         (HT.CHECK "choosing another game puts it, and only it, on the screen" (HCT.OnShow? HCT.Second))
         (HT.CHECK "its card table is brought up to date" (HCT.UpToDate? HCT.Second))
         (DISMISS 4000)
         (HT.CHECK "it stays on show while the others play" (HCT.OnShow? HCT.Second))
         (HT.SNAP "tables-second")
         (HC.Pick HCT.First)
         (HT.CHECK "and back again" (AND (HCT.OnShow? HCT.First) (HCT.UpToDate? HCT.First))))
(HT.CHECK "every game ends" (HCT.WaitFor (QUOTE (EQ (LENGTH HCT.Finished) HCT.Want)) 1500))
(HT.CHECK "no game is left, and the offer stands" (LIST HC.Games (LENGTH HC.Forward)) (QUOTE (NIL 3)))
(HT.CHECK "each had winners" (for Game in HCT.Finished always (for N in (HCT.Winners Game) always (AND (IGEQ N 1) (ILEQ N 4)))))
(HT.CHECK "each game's scores add up to 26 a deal: no game saw another's cards or tricks"
  (for Game in HCT.Finished always (EQ 0 (IREMAINDER (for S in (HCT.Totals Game) sum S) 26))))
(HT.LOG (LIST (QUOTE TOTALS) (for Game in HCT.Finished collect (HCT.Totals Game)) (QUOTE CALLS) HC.Calls))
