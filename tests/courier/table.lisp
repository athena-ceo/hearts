(* "HEARTS over Courier: this Medley's 1986 players sit at a table of the house and play a whole game.  Run by tests/run-courier.sh.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/dist/HCOURIER")
(HT.AUTOPLACE)
(ADVISE (QUOTE CT.Open) (QUOTE AFTER) (QUOTE (WINDOWPROP !VALUE (QUOTE Delay) 0)))
(DEFINEQ
(HCT.WaitFor (LAMBDA (Form Secs)
  (for I from 1 to (TIMES 2 Secs) until (EVAL Form) do (DISMISS 500))
  (EVAL Form)))
)
(SETQ HCT.Plays 0)
(SETQ HCT.Tricks 0)
(CL:PROCLAIM (QUOTE (CL:SPECIAL HCT.Plays HCT.Tricks)))
(ADVISE (QUOTE CP.Play) (QUOTE BEFORE) (QUOTE (SETQ HCT.Plays (ADD1 HCT.Plays))))
(ADVISE (QUOTE CP.Trick) (QUOTE BEFORE) (QUOTE (SETQ HCT.Tricks (ADD1 HCT.Tricks))))
(DISMISS 5000)
(HT.CHECK "the house lists its players" (for O in (HC.Opponents) thereis (EQUAL (CAR O) "expert")))
(HT.LOG (LIST (QUOTE OPPONENTS) (HC.Opponents)))
(HT.CHECK "a table that doesn't exist is refused, as a declared error" (CADR (HC.Sit (LIST (CP.Create NIL)) "nosuchtable")) (QUOTE NO.SUCH.TABLE))
(HT.CHECK "five players are refused" (CADR (HC.NewTable (LIST (CP.Create NIL) (CP.Create NIL)) (QUOTE ("expert" "expert" "expert")))) (QUOTE BAD.REQUEST))
(SETQ HCT.Table (HC.NewTable (LIST (CP.Create NIL) (CP.Create NIL)) (QUOTE ("expert" "network"))))
(HT.LOG (LIST (QUOTE TABLE) HCT.Table))
(HT.CHECK "two Conservatives sit at a new table with the house's Expert and network" (STRINGP HCT.Table))
(HT.CHECK "the game starts here" (HCT.WaitFor (QUOTE HC.Playing) 30))
(HT.CHECK "the 1986 card table opens" (AND (WINDOWP HNET.CardTable) (OPENWP HNET.CardTable)))
(HT.CHECK "the players have seats 1 and 2" (for P in HNET.MyPlayers collect (fetch Number of P)) (QUOTE (1 2)))
(HCT.WaitFor (QUOTE (IGREATERP HCT.Tricks 8)) 120)
(HT.SNAP "courier-table")
(HT.CHECK "the hands hold 1986 cards: 2 to 10, J, Q, K, A"
  (for P in HNET.MyPlayers always (for C in (Hand.Cards (fetch Hand of (fetch Object of P))) always (FMEMB (fetch Value of C) CardValues))))
(HT.CHECK "a card crosses the wire and back unchanged"
  (for C in (QUOTE ((S . Q) (H . 2) (C . 10) (D . A) (S . J) (H . K))) always (EQUAL C (HC.FromWire (HC.ToWire C)))))
(HT.CHECK "the game ends" (HCT.WaitFor (QUOTE HC.Winners) 1500))
(HT.LOG (LIST (QUOTE SCORE) HC.Scores (QUOTE WINNERS) HC.Winners (QUOTE PLAYS) HCT.Plays (QUOTE TRICKS) HCT.Tricks (QUOTE CALLS) HC.Calls))
(HT.CHECK "someone went over 100" (for S in HC.Scores thereis (IGREATERP S 100)))
(HT.CHECK "the scores add up to 26 a deal" (EQ 0 (IREMAINDER (for S in HC.Scores sum S) 26)))
(HT.CHECK "each Conservative was asked for 13 cards a deal" (EQ 0 (IREMAINDER HCT.Plays 26)))
(HT.CHECK "leaving is accepted" (LIST (HC.Leave)) (QUOTE (NIL)))
(HT.CHECK "offering players with the wrong key is refused" (CADR (HC.Offer (LIST (CP.Create NIL)) "not-the-key")) (QUOTE NOT.ALLOWED))
(HT.CHECK "offering them with the key is accepted" (HC.Offer (LIST (CP.Create NIL)) "test-key" (QUOTE ("A Conservative on Medley"))) T)
(HT.CHECK "the house lists the tables waiting for players: none" (LIST (HC.Tables)) (QUOTE (NIL)))
(HT.CHECK "leaving again" (LIST (HC.Leave)) (QUOTE (NIL)))
