(* "TRIAL: a Medley that calls the server's EVAL Courier program with the stock REMOTEEVAL and REMOTEAPPLY.")
(FILESLOAD COURIEREVALSERVE)
(LOAD "{DSK}/hearts/tests/courier/program.lisp")
(HT.LOG (LIST (QUOTE CLIENT-ADDRESS) \MY.NSADDRESS))
(DISMISS 20000)
(SETQ Addr (\COERCE.TO.NSADDRESS "0#10000.125000.1#"))
(HT.LOG (LIST (QUOTE ADDR) Addr))
(SETQ CS (COURIER.OPEN Addr NIL T (QUOTE TRIAL)))
(HT.CHECK "a Courier stream opens to the other Medley" (STREAMP CS))
(HT.CHECK "REMOTEEVAL evaluates there" (REMOTEEVAL (QUOTE (IPLUS 2 3)) CS) 5)
(HT.CHECK "REMOTEEVAL of a function defined only there" (REMOTEEVAL (QUOTE (Greet "client")) CS) "Hello client, this is the server")
(HT.CHECK "REMOTEAPPLY" (REMOTEAPPLY (QUOTE Greet) (LIST "apply") CS) "Hello apply, this is the server")
(HT.CHECK "a remote error is an error here" (NULL (NLSETQ (REMOTEEVAL (QUOTE (CAR (NoSuchFn))) CS))) T)
(HT.CHECK "the stock EVAL program evaluates anything at all, here an environment lookup" (STRINGP (REMOTEEVAL (QUOTE (UNIX-GETENV "HOME")) CS)))
(HT.LOG (LIST (QUOTE REMOTE-HOME) (REMOTEEVAL (QUOTE (UNIX-GETENV "HOME")) CS)))
(SETQ T0 (CLOCK 0))
(for I from 1 to 50 do (REMOTEEVAL (LIST (QUOTE IPLUS) I 1) CS))
(HT.LOG (LIST (QUOTE MS-PER-CALL) (IQUOTIENT (IDIFFERENCE (CLOCK 0) T0) 50)))
(HT.CHECK "an expedited (single packet) call" (COURIER.EXPEDITED.CALL Addr 5 (QUOTE EVAL) (QUOTE EVAL) "(IPLUS 20 3)" (QUOTE RETURNERRORS)) "23")
(SETQ Hand (QUOTE (("S" 12) ("H" 3) ("C" 9))))
(HT.CHECK "our own program: a typed call with a record result" (COURIER.CALL CS (QUOTE HEARTSTRIAL) (QUOTE LOWEST) Hand) (QUOTE ("H" 3)))
(HT.CHECK "our own program: a declared error comes back as data" (COURIER.CALL CS (QUOTE HEARTSTRIAL) (QUOTE LOWEST) NIL (QUOTE RETURNERRORS)) (QUOTE (ERROR NO.CARDS "no cards")))
(HT.CHECK "our own program, expedited" (COURIER.EXPEDITED.CALL Addr 5 (QUOTE HEARTSTRIAL) (QUOTE LOWEST) Hand (QUOTE RETURNERRORS)) (QUOTE ("H" 3)))
(CLOSEF CS)
