# Copyright (c) 2026 Athena Decision Systems SAS.
# Copy to .env and fill in. Read automatically by `docker compose` / ./hearts.sh.

# Creates invitations and reads the admin routes (X-Hearts-Admin). Leave blank to disable them.
HEARTS_ADMIN_PASSWORD=

# The key a Medley gives to offer its players to everyone (the resident Medley has it).  Leave
# blank and any Medley on the NetHub may; set it on a server.
HEARTS_OFFER_KEY=

# Ports (optional; defaults shown). Distinct from golden-path (8020/3020), xcape (8030/3030)
# and advent (8040/3040).
BACKEND_PORT=8050
FRONTEND_PORT=3050

# For `./hearts.sh deploy prod`, run on the server, and for `./hearts.sh invite prod`.
HEARTS_DEPLOY_SSH=
HEARTS_DEPLOY_DIR=
