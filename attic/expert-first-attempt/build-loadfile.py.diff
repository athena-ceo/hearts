+def load_ep_src():
+    """Load and clean all three Expert Player source files.
+
+    Applies the same mechanical transforms as build():
+      - strip ;; annotation lines
+      - strip #| ... |# transcription notes
+      - convert ← to _
+    Returns a single concatenated string ready to append to the HEARTS text.
+    """
+    parts = []
+    for fname in EP_FILES:
+        raw = (HERE / fname).read_text(encoding="utf-8")
+        # strip #| ... |# blocks
+        raw = re.sub(r"#\|.*?\|#", "", raw, flags=re.DOTALL)
+        # drop ;; annotation lines
+        lines = [ln for ln in raw.split("\n") if not re.match(r"\s*;;", ln)]
+        raw = "\n".join(lines)
+        # convert assignment arrow
+        raw = raw.replace("←", "_")
+        # collapse runs of >2 blank lines
+        raw = re.sub(r"\n{3,}", "\n\n", raw)
+        parts.append(raw.strip())
+    return "\n\n".join(parts)
+
+
 def build(text, dist=False):
     # 2. remove #| ... |# (multi-line, non-greedy)
     text = re.sub(r"#\|.*?\|#", "", text, flags=re.DOTALL)
@@ -241,6 +268,15 @@ def build(text, dist=False):
     text = text.replace("←", "_")
     # collapse runs of >2 blank lines left by stripping
     text = re.sub(r"\n{3,}", "\n\n", text)
+    # 4. Phase 2b: append the Expert Player LOOPS reimplementation.
+    #    ep-loops.lisp, ep-rules.lisp, ep-glue.lisp are already cleaned above
+    #    (;; stripped, ← converted) by load_ep_src().  We append them verbatim
+    #    after the main HEARTS body so the EP.* definitions are defined before
+    #    the player is instantiated.  The H.MakePlayer EP branch calls EP.Create
+    #    (defined in ep-glue.lisp) and EPMapping (also in ep-glue.lisp), so the
+    #    append order here is load-order: loops first, rules second, glue third.
+    ep_src = load_ep_src()
+    text = text + "\n\n" + ep_src + "\n"
     return text
 
 
