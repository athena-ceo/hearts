(* "A hybrid seat: the Expert in seat 1 thinks as usual, then plays the network's card for the kinds of
    decision in HY.Kinds.  Everything is told to the Expert as if it had chosen that card, so its
    history and opponent models stay true to the table.  With every kind on, the seat must score
    exactly as the network does, which checks this file.  Kinds: pass, lead, follow, dump, and
    minimizing, shooting or eclipsing for the Expert's current strategy, and early (tricks 1-6) or late.
    An entry can be a list, such as (shooting lead), meaning all of them.")
(RPAQ? HY.Kinds NIL)
(RPAQ? HY.Except NIL)
(SETQ HY.Net NIL)
(SETQ HY.Used 0)
(DEFINEQ
(HY.Seat1? (LAMBDA (Self)
  (EQ Self HY.Object)))
(HY.Use? (LAMBDA (Kinds)
  (* ; "On if this decision has any kind in HY.Kinds, or all the kinds of a list in HY.Kinds, unless it has one in HY.Except.")
  (AND (for Entry in HY.Kinds
          thereis (if (LISTP Entry)
                      then (for K in Entry always (FMEMB K Kinds))
                    else (FMEMB Entry Kinds)))
       (NOT (for K in Kinds thereis (FMEMB K HY.Except))))))
(HY.PassOut (LAMBDA (ExpertCards Player)
  (* ; "The Expert's pass rules have taken its cards out of the hand.  Put them back to swap in the network's.")
  (if (NOT (HY.Seat1? Player))
      then ExpertCards
    elseif (HY.Use? (QUOTE (pass)))
      then (LET* ((Hand (GET.VALUE Player (QUOTE Hand)))
                  All Selected)
             (for C in ExpertCards do (Hand.AddCard Hand C))
             (SETQ All (Hand.Cards Hand))
             (for I from 1 to 3
                do (SETQ Selected
                     (NCONC1 Selected
                       (NP.Best HY.Net (QUOTE pass)
                                (for C in All collect C unless (MEMB C Selected))
                                All Selected NIL NIL NIL))))
             (for C in Selected do (Hand.RemoveCard Hand C))
             (REMOVE.ALL.LOCAL.VALUES Player (QUOTE PassCards))
             (ADD.VALUES Player (QUOTE PassCards) Selected)
             (SETQ HY.Used (ADD1 HY.Used))
             (replace NP.Passed of HY.Net with Selected)
             Selected)
    else (replace NP.Passed of HY.Net with ExpertCards)
         ExpertCards)))
(HY.Play (LAMBDA (ExpertCard Player Trick HeartsBroken? FirstTrick? Strategy)
  (LET ((Legal (GET.VALUE Player (QUOTE LegalCards)))
        (Mode (SELECTQ (GET.VALUE Player (QUOTE PlayMode))
                 (Lead (QUOTE lead))
                 (FollowSuit (QUOTE follow))
                 (QUOTE dump))))
    (if (AND (HY.Seat1? Player) (CDR Legal) (HY.Use? (LIST Mode Strategy (if (ILEQ (GET.VALUE Player (QUOTE TrickNumber)) 6) then (QUOTE early) else (QUOTE late)))))
        then (SETQ HY.Used (ADD1 HY.Used))
             (PUT.VALUE Player (QUOTE LatestReason) "The network's card.")
             (NP.Best HY.Net (QUOTE play) Legal (Hand.Cards (GET.VALUE Player (QUOTE Hand))) NIL
                      Trick HeartsBroken? FirstTrick?)
      else ExpertCard))))
)
(SETQ NP.ModelFile "/hearts/dist/HEARTSNET")
(SETQ HY.Object NIL)
(NP.Load)
(SETQ HY.Net (create NP NP.Name _ (QUOTE Hybrid)))
(ADVISE (QUOTE EP.GiveHand) (QUOTE AFTER)
  (QUOTE (if (EQP MyNumber 1) then (SETQ HY.Object self) (NP.GiveHand HY.Net Hand MyNumber))))
(ADVISE (QUOTE EP.PassOut) (QUOTE BEFORE)
  (QUOTE (if (HY.Seat1? self) then (replace NP.PassDir of HY.Net with PassDir))))
(ADVISE (QUOTE EP.PassIn) (QUOTE BEFORE)
  (QUOTE (if (HY.Seat1? self) then (replace NP.Received of HY.Net with PassIn))))
(ADVISE (QUOTE EP.Trick) (QUOTE AFTER)
  (QUOTE (if (HY.Seat1? self) then (NP.Trick HY.Net Trick))))
(ADVISE (QUOTE EP.MinPass) (QUOTE AROUND) (QUOTE (HY.PassOut * Player)))
(ADVISE (QUOTE EP.ShootPass) (QUOTE AROUND) (QUOTE (HY.PassOut * Player)))
(ADVISE (QUOTE EP.MinPlay) (QUOTE AROUND)
  (QUOTE (HY.Play * Player Trick HeartsBroken? FirstTrick? (QUOTE minimizing))))
(ADVISE (QUOTE EP.ShootPlay) (QUOTE AROUND)
  (QUOTE (HY.Play * Player Trick HeartsBroken? FirstTrick? (QUOTE shooting))))
(ADVISE (QUOTE EP.EclipsePlay) (QUOTE AROUND)
  (QUOTE (HY.Play * Player Trick HeartsBroken? FirstTrick? (QUOTE eclipsing))))
(* "No file may end a nested LOAD without STOP.")
STOP
