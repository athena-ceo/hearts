(* "Propagation of constraints, as section 3.4 of the 1986 report proposed: from the cards seen, seat 1's
    hand, the voids shown, the cards it passed and the size of each hand, the fewest and most cards of
    each suit that each opponent can hold.  PR.Low and PR.High are indexed 3 x suit + opponent, with
    suits C D H S and opponents seats 2 3 4.  bench/hall.py is the same arithmetic in Python, checked
    against a linear program.  It leaves the 1986 rule base alone: rule files use these facts.")
(LOAD "{DSK}/hearts/bench/rules/epx.lisp")
(RPAQ? PR.CashMode (QUOTE propagated))
(RPAQ? PR.FilterMode NIL)
(RPAQ? PR.Feed? NIL)
(RPAQ? PR.Checking? NIL)
(RPAQ? PR.LogFile NIL)
(SETQ PR.Low (ARRAY 12 (QUOTE POINTER) 0 0))
(SETQ PR.High (ARRAY 12 (QUOTE POINTER) 0 0))
(SETQ PR.Checks 0)
(SETQ PR.Violations 0)
(DEFINEQ
(PR.In? (LAMBDA (Mask S)
  (NOT (ZEROP (LOGAND Mask (LLSH 1 S))))))
(PR.Feasible (LAMBDA (Sup Need Allow)
  (* ; "Hall's condition.  Supply and need have equal totals.")
  (for Mask from 1 to 15
     always (LET ((Total 0) (Room 0))
              (for S from 0 to 3
                 do (if (PR.In? Mask S) then (SETQ Total (IPLUS Total (ELT Sup S)))))
              (for O from 0 to 2
                 do (if (for S from 0 to 3
                           thereis (AND (PR.In? Mask S) (EQP 1 (ELT Allow (IPLUS (ITIMES S 3) O)))))
                        then (SETQ Room (IPLUS Room (ELT Need O)))))
              (ILEQ Total Room)))))
(PR.HighBound (LAMBDA (S O Sup Need Allow)
  (LET ((A (ELT Sup S)) (B (ELT Need O)) (Best 0))
    (for K from (IMIN A B) to 1 by -1
       do (SETA Sup S (IDIFFERENCE A K))
          (SETA Need O (IDIFFERENCE B K))
          (if (PR.Feasible Sup Need Allow)
              then (SETQ Best K)
                   (RETURN)))
    (SETA Sup S A)
    (SETA Need O B)
    Best)))
(PR.LowBound (LAMBDA (S O Sup Need Allow)
  (* ; "Minimum cut, with the edge from suit S to opponent O limited.")
  (LET ((Least 0))
    (for Mask from 1 to 15
       do (if (AND (PR.In? Mask S)
                   (NOT (for Tt from 0 to 3
                           thereis (AND (PR.In? Mask Tt) (NOT (EQP Tt S))
                                        (EQP 1 (ELT Allow (IPLUS (ITIMES Tt 3) O)))))))
              then (LET ((Total 0) (Others 0))
                     (for Tt from 0 to 3
                        do (if (PR.In? Mask Tt) then (SETQ Total (IPLUS Total (ELT Sup Tt)))))
                     (for P from 0 to 2
                        do (if (AND (NOT (EQP P O))
                                    (for Tt from 0 to 3
                                       thereis (AND (PR.In? Mask Tt)
                                                    (EQP 1 (ELT Allow (IPLUS (ITIMES Tt 3) P))))))
                               then (SETQ Others (IPLUS Others (ELT Need P)))))
                     (SETQ Least (IMAX Least (IDIFFERENCE Total Others))))))
    Least)))
(PR.SuitIndex (LAMBDA (Suit)
  (SELECTQ Suit (C 0) (D 1) (H 2) 3)))
(PR.SuitCount (LAMBDA (Cards Suit)
  (for C in Cards count (EQ (fetch Suit of C) Suit))))
(PR.OtherHand (LAMBDA (O)
  (* ; "An opponent's true hand, for the oracle and the check only: every seat is an Expert in these runs.")
  (GET.VALUE (fetch Object of (CAR (NTH (fetch Players of H.LastGame) (IPLUS O 2)))) (QUOTE Hand))))
(PR.Compute (LAMBDA (Self Trick)
  (LET* ((Hist (GET.VALUE Self (QUOTE history)))
         (Mine (Hand.Cards (GET.VALUE Self (QUOTE Hand))))
         (OnTable (Trick.Cards Trick))
         (Leader (fetch LeadPlayerNum of Trick))
         (Left (GET.VALUES Hist (QUOTE CardsLeft)))
         (Played (APPEND OnTable (GET.VALUES Hist (QUOTE CardsPlayed))))
         (Size (LENGTH Mine))
         (Sup (ARRAY 4 (QUOTE POINTER) 0 0))
         (Need (ARRAY 3 (QUOTE POINTER) 0 0))
         (Allow (ARRAY 12 (QUOTE POINTER) 1 0))
         (Pin (ARRAY 12 (QUOTE POINTER) 0 0)))
    (for Suit in (QUOTE (C D H S)) as S from 0
       do (SETA Sup S (IDIFFERENCE (IDIFFERENCE (PR.SuitCount Left Suit) (PR.SuitCount Mine Suit))
                                   (PR.SuitCount OnTable Suit))))
    (for O from 0 to 2
       do (LET* ((Seat (IPLUS O 2))
                 (Offset (IREMAINDER (IPLUS (IDIFFERENCE Seat Leader) 4) 4))
                 (Model (UNITMSG Self (QUOTE GetOpponent) Seat)))
            (SETA Need O (if (ILESSP Offset (LENGTH OnTable)) then (SUB1 Size) else Size))
            (for Suit in (GET.VALUES Model (QUOTE Voids))
               do (SETA Allow (IPLUS (ITIMES (PR.SuitIndex Suit) 3) O) 0))
            (if (ILESSP Offset (LENGTH OnTable))
                then (LET ((Card (CAR (NTH OnTable (ADD1 Offset)))))
                       (if (NEQ (fetch Suit of Card) (fetch Suit of (CAR OnTable)))
                           then (SETA Allow (IPLUS (ITIMES (PR.SuitIndex (fetch Suit of (CAR OnTable))) 3) O) 0))))
            (for Card in (GET.VALUES Model (QUOTE HandCards))
               unless (CardList.Member Card Played)
               do (LET ((S (PR.SuitIndex (fetch Suit of Card))))
                    (SETA Pin (IPLUS (ITIMES S 3) O) (ADD1 (ELT Pin (IPLUS (ITIMES S 3) O))))
                    (SETA Sup S (SUB1 (ELT Sup S)))
                    (SETA Need O (SUB1 (ELT Need O)))))))
    (for S from 0 to 3
       do (for O from 0 to 2
             do (LET ((I (IPLUS (ITIMES S 3) O)))
                  (SETA PR.Low I 0)
                  (SETA PR.High I 0)
                  (if (EQP 1 (ELT Allow I))
                      then (SETA PR.High I (PR.HighBound S O Sup Need Allow))
                           (SETA PR.Low I (PR.LowBound S O Sup Need Allow)))
                  (SETA PR.Low I (IPLUS (ELT PR.Low I) (ELT Pin I)))
                  (SETA PR.High I (IPLUS (ELT PR.High I) (ELT Pin I))))))
    (if PR.Checking? then (PR.Check Size))
    NIL)))
(PR.Check (LAMBDA (Size)
  (* ; "Each deduction against the real hands, and a log for bench/propagate_check.py.")
  (for Suit in (QUOTE (C D H S)) as S from 0
     do (for O from 0 to 2
           do (LET ((Held (LENGTH (Hand.CardsInSuit (PR.OtherHand O) Suit)))
                    (I (IPLUS (ITIMES S 3) O)))
                (SETQ PR.Checks (ADD1 PR.Checks))
                (if (OR (ILESSP Held (ELT PR.Low I)) (IGREATERP Held (ELT PR.High I)))
                    then (SETQ PR.Violations (ADD1 PR.Violations))))))
  (if PR.LogFile
      then (LET ((Stream (OPENSTREAM (CONCAT "{UNIX}" PR.LogFile) (QUOTE APPEND))))
             (PRIN3 "{%"deal%":" Stream)
             (PRIN3 (IPLUS BM.First BM.Dealt -1) Stream)
             (PRIN3 ",%"trick%":" Stream)
             (PRIN3 (IDIFFERENCE 14 Size) Stream)
             (PRIN3 ",%"low%":[" Stream)
             (for I from 0 to 11
                do (if (IGREATERP I 0) then (PRIN3 "," Stream))
                   (PRIN3 (ELT PR.Low I) Stream))
             (PRIN3 "],%"high%":[" Stream)
             (for I from 0 to 11
                do (if (IGREATERP I 0) then (PRIN3 "," Stream))
                   (PRIN3 (ELT PR.High I) Stream))
             (PRIN3 "]}" Stream)
             (TERPRI Stream)
             (CLOSEF Stream)))))
(PR.VoidCount (LAMBDA (Suit)
  (LET ((S (PR.SuitIndex Suit)))
    (for O from 0 to 2 count (ZEROP (ELT PR.High (IPLUS (ITIMES S 3) O)))))))
(PR.SureCount (LAMBDA (Suit)
  (LET ((S (PR.SuitIndex Suit)))
    (for O from 0 to 2 count (IGREATERP (ELT PR.Low (IPLUS (ITIMES S 3) O)) 0)))))
(PR.SingleCount (LAMBDA (Suit)
  (LET ((S (PR.SuitIndex Suit)))
    (for O from 0 to 2 count (AND (EQP 1 (ELT PR.Low (IPLUS (ITIMES S 3) O)))
                                  (EQP 1 (ELT PR.High (IPLUS (ITIMES S 3) O))))))))
(PR.ShownVoidCount (LAMBDA (Self Suit)
  (for O from 2 to 4 count (FMEMB Suit (GET.VALUES (UNITMSG Self (QUOTE GetOpponent) O) (QUOTE Voids))))))
(PR.TrueVoidCount (LAMBDA (Suit)
  (for O from 0 to 2 count (NULL (Hand.CardsInSuit (PR.OtherHand O) Suit)))))
(PR.Count (LAMBDA (Self Suit Mode)
  (* ; "How many opponents are void in this suit, as far as this kind of knowledge goes.")
  (SELECTQ Mode
    (shown (PR.ShownVoidCount Self Suit))
    (true (PR.TrueVoidCount Suit))
    (PR.VoidCount Suit))))
(PR.CashOK (LAMBDA (Self Suit)
  (if (EQ PR.CashMode (QUOTE sure))
      then (EQP 3 (PR.SureCount Suit))
    else (ZEROP (PR.Count Self Suit PR.CashMode)))))
(PR.QueenSafe? (LAMBDA (Self Hist)
  (LET ((Queen (Card.Create (QUOTE Q) (QUOTE S))))
    (OR (CardList.Member Queen (GET.VALUES Hist (QUOTE CardsPlayed)))
        (CardList.Member Queen (Hand.Cards (GET.VALUE Self (QUOTE Hand))))))))
(PR.CashCards (LAMBDA (Self Hist Legals)
  (* ; "My winners in a suit where the opponents can still follow, leaving hearts, and spades while the queen is out.")
  (for C in (UNITMSG Hist (QUOTE Winners) NIL Legals)
     when (AND (NEQ (fetch Suit of C) (QUOTE H))
               (OR (NEQ (fetch Suit of C) (QUOTE S)) (PR.QueenSafe? Self Hist))
               (PR.CashOK Self (fetch Suit of C)))
     collect C)))
(PR.UnderSingle (LAMBDA (Hist Legals)
  (* ; "Non-hearts that can lose, in a suit where some opponent holds exactly one card and so has no choice.")
  (LET ((Winners (UNITMSG Hist (QUOTE Winners) NIL Legals)))
    (for C in Legals
       when (AND (NEQ (fetch Suit of C) (QUOTE H))
                 (NOT (CardList.Member C Winners))
                 (IGREATERP (PR.SingleCount (fetch Suit of C)) 0))
       collect C))))
(PR.Before (LAMBDA (Player Trick)
  (* ; "Before seat 1's strategy chooses a card: work out the facts, and apply the input changes.")
  (if (EQ Player (fetch Object of (CAR (fetch Players of H.LastGame))))
      then (PR.Compute Player Trick)
           (if PR.Feed?
               then (for Suit in (QUOTE (C D H S)) as S from 0
                       do (for O from 0 to 2
                             do (if (ZEROP (ELT PR.High (IPLUS (ITIMES S 3) O)))
                                    then (REPLACE.VALUE (UNITMSG Player (QUOTE GetOpponent) (IPLUS O 2))
                                                        (QUOTE Voids) Suit Suit NIL T)))))
           (if (AND PR.FilterMode (NULL (Trick.Cards Trick)))
               then (LET* ((Legal (GET.VALUE Player (QUOTE LegalCards)))
                           (Kept (for C in Legal
                                    unless (EQP 3 (PR.Count Player (fetch Suit of C) PR.FilterMode))
                                    collect C)))
                      (if (AND Kept (LDIFFERENCE Legal Kept))
                          then (PUT.VALUE Player (QUOTE LegalCards) Kept)))))))
)
(NLSETQ (CL:COMPILE (QUOTE PR.In?)))
(NLSETQ (CL:COMPILE (QUOTE PR.Feasible)))
(NLSETQ (CL:COMPILE (QUOTE PR.HighBound)))
(NLSETQ (CL:COMPILE (QUOTE PR.LowBound)))
(ADVISE (QUOTE EP.MinPlay) (QUOTE BEFORE) (QUOTE (PR.Before Player Trick)))
(ADVISE (QUOTE EP.ShootPlay) (QUOTE BEFORE) (QUOTE (PR.Before Player Trick)))
(ADVISE (QUOTE EP.EclipsePlay) (QUOTE BEFORE) (QUOTE (PR.Before Player Trick)))
(ADVISE (QUOTE EPX.Report) (QUOTE AFTER)
  (QUOTE (SETQ !VALUE (LIST !VALUE (QUOTE checks) PR.Checks (QUOTE violations) PR.Violations))))
STOP
