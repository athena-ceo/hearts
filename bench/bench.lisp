(* "One benchmark run: a player in seat 1 plays fixed deals against the same opponents.  bench/run.py
    puts the settings (BM.* and LP.*) in front of this file.  Everything is one long game, so the
    pass direction follows the deal number and the Expert keeps modelling its opponents; the over
    score is out of reach, so nobody plays for the end of a game.")
(LOAD "{DSK}/hearts/medley/HEARTS")
(LOAD "{DSK}/hearts/medley/EXPERT")
(LOAD "{DSK}/hearts/dist/LLMPLAYER")
(LOAD "{DSK}/hearts/dist/NNPLAYER")
(LOAD "{DSK}/hearts/bench/deals.lisp")
(if BM.Extra then (LOAD (CONCAT "{DSK}/hearts/" BM.Extra)))
(HT.AUTOPLACE)
(DEFINEQ
(BM.Shuffle (LAMBDA (Deck)
  (SETQ BM.Dealt (ADD1 BM.Dealt))
  (SETQ BM.DealStart (CLOCK 0))
  (LET ((Fresh (Card.CreateDeck)))
    (for I from 1 to 52 as Position in (CAR (NTH BM.AllDeals (IPLUS BM.First BM.Dealt -1)))
       do (SETA Deck I (ELT Fresh Position))))
  Deck))
(BM.CardName (LAMBDA (Card)
  (CONCAT (fetch Suit of Card) (fetch Value of Card))))
(BM.QueenTaker (LAMBDA (Deal)
  (for Trick in (fetch Tricks of Deal)
     thereis (for Card in (fetch Cards of Trick)
                thereis (EQUAL (BM.CardName Card) "SQ"))
     finally (RETURN (AND $$VAL (fetch Winner of $$VAL))))))
(BM.Join (LAMBDA (Items Separator)
  (LET ((Text ""))
    (for Item in Items as I from 1
       do (SETQ Text (CONCAT Text (if (EQP I 1) then "" else Separator) Item)))
    Text)))
(BM.Cards (LAMBDA (S Cards)
  (PRIN3 "[" S)
  (for C in Cards as I from 1
     do (if (GREATERP I 1) then (PRIN3 "," S))
        (LP.JString S (BM.CardName C)))
  (PRIN3 "]" S)))
(BM.Reasons (LAMBDA (S Player)
  (* ; "An Expert's reasons for this deal as a JSON list, newest first; other kinds of player have none.")
  (PRIN3 "[" S)
  (if (EQ (fetch Type of Player) (QUOTE Kee))
      then (for R in (GET.VALUES (GET.VALUE (fetch Object of Player) (QUOTE history)) (QUOTE Reasons)) as I from 1
              do (if (GREATERP I 1) then (PRIN3 "," S))
                 (LP.JString S (CONCAT (CAR R) " " (CADR R)))))
  (PRIN3 "]" S)))
(BM.Trace (LAMBDA (Deal)
  (* ; "The whole deal, the first seat's reasons (reasons, what bench/analyze_expert.py reads), every seat's reasons (seat_reasons), both newest first, and the rules that fired in this deal, newest first, for all seats (fired): what scripts/medley_conformance.py reads.")
  (LET ((S (OPENSTREAM (CONCAT "{UNIX}" BM.TraceFile) (QUOTE APPEND))))
    (PRIN3 "{%"deal%":" S) (PRIN3 (IPLUS BM.First BM.Dealt -1) S)
    (PRIN3 ",%"hands%":[" S)
    (for H in (fetch Hands of Deal) as I from 1
       do (if (GREATERP I 1) then (PRIN3 "," S))
          (BM.Cards S (Hand.Cards H)))
    (PRIN3 "],%"passed%":[" S)
    (for P in (fetch PassOut of Deal) as I from 1
       do (if (GREATERP I 1) then (PRIN3 "," S))
          (BM.Cards S P))
    (PRIN3 "],%"tricks%":[" S)
    (for Tr in (fetch Tricks of Deal) as I from 1
       do (if (GREATERP I 1) then (PRIN3 "," S))
          (PRIN3 "{%"leader%":" S) (PRIN3 (fetch LeadPlayerNum of Tr) S)
          (PRIN3 ",%"winner%":" S) (PRIN3 (fetch Winner of Tr) S)
          (PRIN3 ",%"cards%":" S) (BM.Cards S (fetch Cards of Tr))
          (PRIN3 "}" S))
    (PRIN3 "],%"reasons%":" S)
    (BM.Reasons S (CAR (fetch Players of H.LastGame)))
    (PRIN3 ",%"seat_reasons%":[" S)
    (for P in (fetch Players of H.LastGame) as I from 1
       do (if (GREATERP I 1) then (PRIN3 "," S))
          (BM.Reasons S P))
    (PRIN3 "],%"fired%":[" S)
    (for Tail on KEE.Fired as I from 1 until (EQ Tail BM.LastFired)
       do (if (GREATERP I 1) then (PRIN3 "," S))
          (LP.JString S (CAR Tail)))
    (SETQ BM.LastFired KEE.Fired)
    (PRIN3 "]}" S)
    (TERPRI S)
    (CLOSEF S))))
(BM.Cost (LAMBDA NIL
  (FPLUS (FTIMES LP.InputTokens BM.PriceIn) (FTIMES LP.OutputTokens BM.PriceOut))))
(BM.Record (LAMBDA (Deal)
  (LET ((S (OPENSTREAM (CONCAT "{UNIX}" BM.Results) (QUOTE APPEND))))
    (PRIN1 (CONCAT "{%"deal%":" (IPLUS BM.First BM.Dealt -1)
                   ",%"pass%":%"" (OR (fetch PassDir of Deal) "None") "%""
                   ",%"scores%":[" (BM.Join (fetch D.Score of Deal) ",") "]"
                   ",%"queen%":" (OR (BM.QueenTaker Deal) 0)
                   ",%"hand%":%"" (BM.Join (for C in (Hand.Cards (CAR (fetch Hands of Deal))) collect (BM.CardName C)) " ") "%""
                   ",%"ms%":" (IDIFFERENCE (CLOCK 0) BM.DealStart)
                   ",%"decisions%":" LP.Decisions
                   ",%"fallbacks%":" LP.Fallbacks
                   ",%"input_tokens%":" LP.InputTokens
                   ",%"output_tokens%":" LP.OutputTokens
                   "}")
           S)
    (TERPRI S)
    (CLOSEF S))
  (* ; "Stop at the budget, and when the model mostly isn't answering: that would measure the fallback.")
  (if (OR (GREATERP (BM.Cost) (TIMES BM.Budget 1000000.0))
          (AND (IGREATERP LP.Decisions 9) (IGREATERP (ITIMES 2 LP.Fallbacks) LP.Decisions)))
      then (SETQ BM.Stop T))))
)
(SETQ Game.OverScore 100000)
(SETQ BM.Dealt 0)
(SETQ BM.Stop NIL)
(SETQ BM.LastFired NIL)
(ADVISE (QUOTE H.Shuffle) (QUOTE AROUND) (QUOTE (BM.Shuffle Deck)))
(ADVISE (QUOTE Game.Update) (QUOTE AFTER) (QUOTE (PROGN (BM.Record Deal) (if BM.TraceFile then (BM.Trace Deal)))))
(ADVISE (QUOTE Game.Winner) (QUOTE AFTER) (QUOTE (if (OR BM.Stop (IGEQ BM.Dealt BM.Count)) then (SETQ !VALUE T))))
(* "No pause at the end of each trick: nobody is watching.")
(ADVISE (QUOTE CT.Open) (QUOTE AFTER) (QUOTE (WINDOWPROP !VALUE (QUOTE Delay) 1)))
(LP.ResetStats)
(SETQ BM.Start (CLOCK 0))
(Hearts (for X in BM.Seats collect (H.MakePlayer X NIL)) NIL NIL)
(QUOTIENT (DIFFERENCE (CLOCK 0) BM.Start) 1000)
(LP.Stats)
(NP.Stats)
(HT.CHECK "every deal was played" (EQP BM.Dealt BM.Count))
(* "Rule errors: a Lisp premise that signals an error fails its rule, and is noted here.")
(LENGTH KEE.RuleErrors)
(INTERSECTION (for E in KEE.RuleErrors collect (CAR E)) (for E in KEE.RuleErrors collect (CAR E)))
(if (GETD (QUOTE EPX.Report)) then (EPX.Report))
(HT.SNAP "last-deal")
