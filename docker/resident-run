#!/bin/bash
# resident-run -- the resident HEARTS Medley for the demo server.
#
# Starts Medley on a virtual display and keeps it running.  Two VNC servers show that display,
# and noVNC serves each to a browser:
#   port 6080  watch:   view only (public)
#   port 6081  control: keyboard and mouse.  No password here: publish it only behind nginx's
#                       login (nginx/hearts-apps-location.conf).
# docker/resident.lisp then keeps offering players to the house, over Courier on its NetHub.
#
# Settings (environment): MEDLEY_NETHUB (the house's NetHub and this machine's address on it,
# HOST:PORT:MAC, backend:3333:10-00-AA-00-00-10 in docker-compose.server.yml), RESIDENTKEY (the
# house's key for offering players to everyone), RESIDENTPLAYERS ("EP NP CP"), GEOMETRY (1280x900).
set -u
GEOMETRY="${GEOMETRY:-1280x900}"
export DISPLAY=:0 TERM=dumb
mkdir -p "$HOME/il"

# A restarted container keeps /tmp: clear the last display's lock, or Xvfb won't start and
# Medley can't open its display.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
Xvfb :0 -screen 0 "${GEOMETRY}x24" -nolisten tcp >/dev/null 2>&1 &
for _ in $(seq 1 50); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.1; done 2>/dev/null

# -skip_keycodes 187,188: Xvfb's keyboard has extra keys for ( and ), which x11vnc prefers
# because they need no Shift, but Medley ignores them; skipped, ( and ) go as Shift-9 and Shift-0.
# So does every ( and ) from a keyboard that types them unshifted, like the French one.
KEYS=(-xkb -skip_keycodes 187,188)
x11vnc -display :0 -localhost -rfbport 5901 -viewonly -shared -forever -nopw -quiet "${KEYS[@]}" -nosel >/dev/null 2>&1 &
x11vnc -display :0 -localhost -rfbport 5900 -shared -forever -nopw -quiet "${KEYS[@]}" >/dev/null 2>&1 &
# The clipboard: x11vnc puts what noVNC's clipboard panel sends into the X cut buffer and sends
# the cut buffer back; Medley pastes from, and copies to, the CLIPBOARD selection (with xclip).
# autocutsel keeps the selections and the cut buffer the same.  (The watchers' x11vnc has -nosel.)
autocutsel -selection CLIPBOARD >/dev/null 2>&1 &
autocutsel -selection PRIMARY >/dev/null 2>&1 &
websockify --web /usr/share/novnc 6080 localhost:5901 >/dev/null 2>&1 &
websockify --web /usr/share/novnc 6081 localhost:5900 >/dev/null 2>&1 &

# The exec stuffs a REM.CM that starts with a double quote into its type-ahead (see medley-run).
export RESIDENTLISP="{DSK}/usr/local/share/hearts/resident.lisp"
CM="$HOME/resident.cm"
printf '"(EXEC_INTERLISP) (LOAD (UNIX-GETENV (QUOTE RESIDENTLISP)))"\n' > "$CM"

# Wait until the NetHub answers: the emulator joins it only as it starts, and never tries again.
wait_for_hub() {
  local host port
  [ -n "${MEDLEY_NETHUB:-}" ] || return 0
  host="${MEDLEY_NETHUB%%:*}"; port="${MEDLEY_NETHUB#*:}"; port="${port%%:*}"
  until (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null; do
    echo "$(date -u +%FT%TZ) waiting for the NetHub at $host:$port"
    sleep 3
  done
}

# Run Medley; if it stops (a crash, someone typed LOGOUT, or the house went away and
# resident.lisp logged out to join its NetHub again), start it again.
while :; do
  wait_for_hub
  echo "$(date -u +%FT%TZ) starting Medley"
  "$MEDLEY_HOME/medley/medley" -a -n -i resident -g "$GEOMETRY" -s "$GEOMETRY" -x "$HOME/il" -cm "$CM" \
    ${MEDLEY_NETHUB:+-nh "$MEDLEY_NETHUB"}
  echo "$(date -u +%FT%TZ) Medley stopped ($?); restarting in 5 seconds"
  sleep 5
done
